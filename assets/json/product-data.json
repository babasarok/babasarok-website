
{{- $products := dict -}}
{{- range $file := readDir "data/products" -}}
    {{- if strings.HasSuffix $file.Name ".json" -}}
        {{- $raw := readFile (printf "data/products/%s" $file.Name) -}}
        {{- $jsonData := transform.Unmarshal $raw -}}
        {{- $products = merge $products (dict $jsonData.product_id $jsonData) -}}
    {{- end -}}
{{- end -}}

{{- jsonify (dict "indent" "  ") $products -}}
