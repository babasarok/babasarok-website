+/** A string label for a column, from a string `header`, else the column id. */
+export function headerLabelText<TData>(column: Column<TData, unknown>): string {
+  const header = column.columnDef.header;
+  return typeof header === 'string' ? header : column.id;
+}
+
+export interface CardColumns<TData> {
+  titleColumnId: string | undefined;
+  lines: Array<{ column: Column<TData, unknown>; label: string }>;
+}
+
+/**
+ * Splits the visible columns into the card title and its label/value lines.
+ * Display columns (select, actions) and columns labelled `null` stay off the
+ * lines; the title is picked from the remaining data columns.
+ */
+export function getCardColumns<TData>(
+  visibleColumns: Column<TData, unknown>[],
+  options: {
+    displayColumnIds: string[];
+    label: (column: Column<TData, unknown>) => string | null;
+    pickTitle?: (columns: Column<TData, unknown>[]) => string | undefined;
+  },
+): CardColumns<TData> {
+  const labelled = visibleColumns
+    .filter((column) => !options.displayColumnIds.includes(column.id))
+    .map((column) => ({ column, label: options.label(column) }))
+    .filter((entry): entry is { column: Column<TData, unknown>; label: string } => entry.label !== null);
+  const dataColumns = labelled.map((entry) => entry.column);
+  const titleColumnId = options.pickTitle?.(dataColumns) ?? dataColumns[0]?.id;
+  return {
+    titleColumnId,
+    lines: labelled.filter((entry) => entry.column.id !== titleColumnId),
+  };
+}
