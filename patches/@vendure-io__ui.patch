+'use client';
+
+import { flexRender, type Row, type Table as TanStackTable } from '@tanstack/react-table';
+import { Button } from '@vendure-io/ui/components/atoms/button';
+import { CardContent } from '@vendure-io/ui/components/atoms/card';
+import { Checkbox } from '@vendure-io/ui/components/atoms/checkbox';
+import {
+  ContextMenu,
+  ContextMenuContent,
+  ContextMenuTrigger,
+} from '@vendure-io/ui/components/atoms/context-menu';
+import {
+  NativeSelect,
+  NativeSelectOption,
+} from '@vendure-io/ui/components/atoms/native-select';
+import { Skeleton } from '@vendure-io/ui/components/atoms/skeleton';
+import { Table, TableBody } from '@vendure-io/ui/components/atoms/table';
+import { cn } from '@vendure-io/ui/lib/utils';
+import type {
+  DataTableCardLayout,
+  DataTableProps,
+} from '@vendure-io/ui/components/molecules/data-table/data-table-types';
+import { ArrowDownIcon, ArrowUpIcon } from 'lucide-react';
+import * as React from 'react';
+// Relative: `data-table-helpers` is closed in the package exports.
+import { getCardColumns, headerLabelText } from './data-table-helpers.tsx';
+
+// The card layout of the DataTable body: the same rows, columns and table
+// state as the `<Table>` body, laid out as one card per row for frames too
+// narrow for a column grid. Only the body changes — the header band
+// (controls, bulk bar, chips) and the pagination footer are shared, so every
+// capability keeps working. Column headers don't exist here, so a sort
+// control and a select-all checkbox stand in for them.
+
+const DEFAULT_CARD_BREAKPOINT = 640;
+const ACTIONS_COLUMN_ID = 'actions';
+// A cell whose content is a button (e.g. a ghost link button) would sit
+// indented by the button's padding and taller than a text line; negative
+// margins cancel both, so its text lines up with the label and the other
+// values while the hit area stays the button's own.
+const FLUSH_LEADING_BUTTON =
+  '[&>[data-slot=button]:first-child]:-my-2 [&>[data-slot=button]:first-child]:-ml-2.5';
+
+/**
+ * Whether the body renders as cards. `'auto'` measures the frame itself (not
+ * the viewport), before paint, so a table in a narrow column or sheet
+ * switches too and the first frame never flashes the other layout.
+ */
+function useCardLayout(
+  frameRef: React.RefObject<HTMLElement | null>,
+  cardLayout: Pick<DataTableCardLayout<unknown>, 'mode' | 'breakpoint'> | undefined,
+): boolean {
+  const auto = cardLayout != null && (cardLayout.mode ?? 'auto') === 'auto';
+  const breakpoint = cardLayout?.breakpoint ?? DEFAULT_CARD_BREAKPOINT;
+  const [narrow, setNarrow] = React.useState(false);
+
+  React.useLayoutEffect(() => {
+    const frame = frameRef.current;
+    if (!auto || frame == null) return;
+    const update = () => setNarrow(frame.getBoundingClientRect().width < breakpoint);
+    update();
+    const observer = new ResizeObserver(update);
+    observer.observe(frame);
+    return () => observer.disconnect();
+  }, [frameRef, auto, breakpoint]);
+
+  if (cardLayout == null) return false;
+  return cardLayout.mode === 'always' || narrow;
+}
+
+interface DataTableCardsLabels {
+  empty: string;
+  selectAllRows: string;
+  selectRow: (index: number) => string;
+  sortBy: string;
+  sortNone: string;
+  sortAscending: string;
+  sortDescending: string;
+}
+
+interface DataTableCardsProps<TData> {
+  table: TanStackTable<TData>;
+  cardLayout: DataTableCardLayout<TData>;
+  isLoading: boolean;
+  hasRows: boolean;
+  skeletonRowCount: number;
+  selectColumnId: string | undefined;
+  emptyState: React.ReactNode;
+  contextActions: DataTableProps<TData>['contextActions'];
+  renderRow: DataTableProps<TData>['renderRow'];
+  footerRows: DataTableProps<TData>['footerRows'];
+  labels: DataTableCardsLabels;
+}
+
+function DataTableCards<TData>({
+  table,
+  cardLayout,
+  isLoading,
+  hasRows,
+  skeletonRowCount,
+  selectColumnId,
+  emptyState,
+  contextActions,
+  renderRow,
+  footerRows,
+  labels: l,
+}: DataTableCardsProps<TData>) {
+  const label = cardLayout.columnLabel ?? headerLabelText;
+  const { titleColumnId, lines } = getCardColumns(table.getVisibleLeafColumns(), {
+    displayColumnIds: [selectColumnId, ACTIONS_COLUMN_ID].filter(
+      (id): id is string => id != null,
+    ),
+    label,
+    pickTitle: cardLayout.titleColumnId,
+  });
+  const bodyRows = table.getRowModel().rows;
+  const columnCount = table.getVisibleLeafColumns().length;
+  const sortEntry = table.getState().sorting[0];
+  const sortColumns = lines.filter((line) => line.column.getCanSort());
+  const titleColumn = titleColumnId != null ? table.getColumn(titleColumnId) : undefined;
+  if (titleColumn?.getCanSort()) {
+    const titleLabel = label(titleColumn);
+    if (titleLabel != null) sortColumns.unshift({ column: titleColumn, label: titleLabel });
+  }
+  // The active sort may be on a hidden column (e.g. a list's default sort);
+  // list it so the control shows what the rows are sorted by.
+  const sortedColumn = sortEntry != null ? table.getColumn(sortEntry.id) : undefined;
+  if (sortedColumn != null && !sortColumns.some((entry) => entry.column.id === sortedColumn.id)) {
+    const sortedLabel = label(sortedColumn);
+    if (sortedLabel != null) sortColumns.push({ column: sortedColumn, label: sortedLabel });
+  }
+
+  const renderCard = (row: Row<TData>) => {
+    const cells = row.getVisibleCells();
+    const titleCell = cells.find((cell) => cell.column.id === titleColumnId);
+    const actionsCell = cells.find((cell) => cell.column.id === ACTIONS_COLUMN_ID);
+    const card = (
+      <div
+        data-slot="data-table-card"
+        data-state={row.getIsSelected() ? 'selected' : undefined}
+        className="group/row flex flex-col gap-2 rounded-lg border border-border/50 p-3 data-[state=selected]:border-primary data-[state=selected]:bg-accent"
+      >
+        <div className="flex items-start gap-2">
+          {selectColumnId != null && (
+            <Checkbox
+              checked={row.getIsSelected()}
+              disabled={!row.getCanSelect()}
+              onCheckedChange={(checked) => row.toggleSelected(checked)}
+              aria-label={l.selectRow(row.index)}
+              className="mt-0.5"
+            />
+          )}
+          <div className={cn('min-w-0 flex-1 font-medium wrap-anywhere', FLUSH_LEADING_BUTTON)}>
+            {titleCell && flexRender(titleCell.column.columnDef.cell, titleCell.getContext())}
+          </div>
+          {actionsCell && (
+            <div className="-my-1.5 -mr-1.5 shrink-0">
+              {flexRender(actionsCell.column.columnDef.cell, actionsCell.getContext())}
+            </div>
+          )}
+        </div>
+        {lines.length > 0 && (
+          <dl className="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1.5">
+            {lines.map(({ column, label: lineLabel }) => {
+              const cell = cells.find((candidate) => candidate.column.id === column.id);
+              return (
+                <React.Fragment key={column.id}>
+                  <dt className="text-muted-foreground">{lineLabel}</dt>
+                  <dd className={cn('min-w-0 wrap-anywhere', FLUSH_LEADING_BUTTON)}>
+                    {cell && flexRender(cell.column.columnDef.cell, cell.getContext())}
+                  </dd>
+                </React.Fragment>
+              );
+            })}
+          </dl>
+        )}
+      </div>
+    );
+    if (!contextActions) return card;
+    return (
+      <ContextMenu>
+        <ContextMenuTrigger render={card} />
+        <ContextMenuContent>{contextActions(row.original, { row, table })}</ContextMenuContent>
+      </ContextMenu>
+    );
+  };
+
+  const footer = typeof footerRows === 'function' ? footerRows({ columnCount }) : footerRows;
+  const showSelectAll = selectColumnId != null && bodyRows.length > 0;
+
+  return (
+    <CardContent data-slot="data-table-cards" className="flex flex-col gap-3">
+      {(showSelectAll || sortColumns.length > 0) && (
+        <div className="flex flex-wrap items-center gap-2">
+          {showSelectAll && (
+            // biome-ignore lint/a11y/noLabelWithoutControl: the Checkbox renders the labelled control
+            <label className="mr-auto flex items-center gap-2">
+              <Checkbox
+                checked={table.getIsAllPageRowsSelected()}
+                indeterminate={
+                  table.getIsSomePageRowsSelected() && !table.getIsAllPageRowsSelected()
+                }
+                onCheckedChange={(checked) => table.toggleAllPageRowsSelected(checked)}
+              />
+              <span>{l.selectAllRows}</span>
+            </label>
+          )}
+          {sortColumns.length > 0 && (
+            <div className="ml-auto flex min-w-0 items-center gap-2">
+              <NativeSelect
+                size="sm"
+                aria-label={l.sortBy}
+                className="min-w-0"
+                value={sortEntry?.id ?? ''}
+                onChange={(event) => {
+                  const id = event.target.value;
+                  if (id === '') {
+                    table.setSorting([]);
+                    return;
+                  }
+                  // A newly picked column starts in its first direction, as a
+                  // header click would — not in the previous column's.
+                  const desc = table.getColumn(id)?.getFirstSortDir() === 'desc';
+                  table.setSorting([{ id, desc }]);
+                }}
+              >
+                <NativeSelectOption value="">{l.sortNone}</NativeSelectOption>
+                {sortColumns.map(({ column, label: optionLabel }) => (
+                  <NativeSelectOption key={column.id} value={column.id}>
+                    {optionLabel}
+                  </NativeSelectOption>
+                ))}
+              </NativeSelect>
+              <Button
+                type="button"
+                variant="outline"
+                size="icon-sm"
+                disabled={sortEntry == null}
+                aria-label={sortEntry?.desc ? l.sortDescending : l.sortAscending}
+                onClick={() => {
+                  if (sortEntry == null) return;
+                  table.setSorting([{ id: sortEntry.id, desc: !sortEntry.desc }]);
+                }}
+              >
+                {sortEntry?.desc ? <ArrowDownIcon /> : <ArrowUpIcon />}
+              </Button>
+            </div>
+          )}
+        </div>
+      )}
+      {isLoading && !hasRows ? (
+        <ul className="flex flex-col gap-2">
+          {Array.from({ length: skeletonRowCount }).map((_, index) => (
+            // biome-ignore lint/suspicious/noArrayIndexKey: static placeholders
+            <li key={`skeleton-${index}`} className="flex flex-col gap-2 rounded-lg border border-border/50 p-3">
+              <Skeleton className="h-4 w-1/2" />
+              <Skeleton className="h-4 w-full" />
+            </li>
+          ))}
+        </ul>
+      ) : bodyRows.length === 0 ? (
+        <div className="text-muted-foreground py-6 text-center">{emptyState ?? l.empty}</div>
+      ) : (
+        <>
+          <ul className="flex flex-col gap-2">
+            {bodyRows.map((row) => {
+              const defaultRow = renderCard(row);
+              return (
+                <li key={row.id}>
+                  {renderRow
+                    ? renderRow(row, { table, columnCount, defaultRow, layout: 'cards' })
+                    : defaultRow}
+                </li>
+              );
+            })}
+          </ul>
+          {footer != null && (
+            <Table>
+              <TableBody>{footer}</TableBody>
+            </Table>
+          )}
+        </>
+      )}
+    </CardContent>
+  );
+}
+
+export { DataTableCards, useCardLayout };
