+function pickCardTitleColumnId<TData>(columns: Column<TData, unknown>[]): string | undefined {
+    const metaOf = (column: Column<TData, unknown>) => column.columnDef.meta as any;
+    const flagged = columns.find(column => metaOf(column)?.cardTitle === true);
+    const firstNonAsset = columns.find(column => metaOf(column)?.fieldInfo?.type !== 'Asset');
+    return (flagged ?? firstNonAsset ?? columns[0])?.id;
+}
