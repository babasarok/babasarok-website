+
+// babasarok patch: the card-layout counterpart of DraggableRow — the drag
+// handle sits beside the molecule's default card. `touch-none` lets the
+// pointer sensor own touch drags instead of the page scrolling.
+function DraggableCard<TData>({ row, card, getRowCanDrag }: Readonly<DraggableCardProps<TData>>) {
+    const { t } = useLingui();
+    const rowCanDrag = getRowCanDrag ? getRowCanDrag(row) : true;
+    const { attributes, listeners, setNodeRef, transform, transition, isDragging } = useSortable({
+        id: row.id,
+        disabled: !rowCanDrag,
+    });
+
+    return (
+        <div
+            ref={setNodeRef}
+            style={{ transform: CSS.Transform.toString(transform), transition, opacity: isDragging ? 0.5 : 1 }}
+            className="flex items-stretch gap-1 animate-in fade-in duration-100"
+        >
+            <div className="flex w-6 shrink-0 items-center justify-center">
+                {rowCanDrag ? (
+                    <div
+                        {...attributes}
+                        {...listeners}
+                        aria-label={t`Drag to reorder`}
+                        className="cursor-move touch-none text-muted-foreground hover:text-foreground transition-colors"
+                    >
+                        <GripVertical className="h-4 w-4" />
+                    </div>
+                ) : null}
+            </div>
+            <div className="min-w-0 flex-1">{card}</div>
+        </div>
+    );
+}
+
+// babasarok patch: the card layout's title — a column flagged `meta.cardTitle`,
