{{- $thumbnail := "" -}}
{{- with .Params.thumbnail -}}
  {{- with resources.Get . -}}
    {{- $thumbnail = .RelPermalink -}}
  {{- end -}}
{{- end -}}
{{- $featureImage := "" -}}
{{- with .Params.featureImage -}}
  {{- with resources.Get . -}}
    {{- $featureImage = .RelPermalink -}}
  {{- end -}}
{{- end -}}
{{- $postImage := "" -}}
{{- with .Params.postImage -}}
  {{- with resources.Get . -}}
    {{- $postImage = .RelPermalink -}}
  {{- end -}}
{{- end -}}
{{- dict
  "kind" .Kind
  "title" .Title
  "permalink" .Permalink
  "path" (printf "content/%s" .File.Path)
  "summary" (.Summary | plainify)
  "content" (.Plain | plainify)
  "date" (.Date.Format "2006-01-02")
  "publishDate" (.PublishDate.Format "2006-01-02")
  "frontmatter" .Params
  "categories" .Params.categories
  "tags" .Params.tags
  "thumbnail" $thumbnail
  "featureImage" $featureImage
  "postImage" $postImage
  "shortDescription" .Params.shortDescription
  "table" .Params.table
| jsonify -}}
