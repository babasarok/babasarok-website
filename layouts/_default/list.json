{{- $items := slice -}}
{{- range .Pages -}}
  {{- $thumbnail := "" -}}
  {{- with .Params.thumbnail -}}
    {{- with resources.Get . -}}
      {{- $thumbnail = .RelPermalink -}}
    {{- end -}}
  {{- end -}}
  {{- $featureImage := "" -}}
  {{- with .Params.featureImage -}}
    {{- with resources.Get . -}}
      {{- $featureImage = .RelPermalink -}}
    {{- end -}}
  {{- end -}}
  {{- $items = $items | append (dict
    "title" .Title
    "label" (.Params.label | default .Title)
    "permalink" .Permalink
    "path" (printf "content/%s" .File.Path)
    "summary" (.Summary | plainify)
    "categories" .Params.categories
    "tags" .Params.tags
    "thumbnail" $thumbnail
    "featureImage" $featureImage
    "date" (.Date.Format "2006-01-02")
    "publishDate" (.PublishDate.Format "2006-01-02")
    "frontmatter" .Params
  ) -}}
{{- end -}}
{{- dict
  "kind" .Kind
  "title" .Title
  "permalink" .Permalink
  "path" (printf "content/%s" .File.Path)
  "description" .Description
  "pages" $items
  "paginator" (dict
    "pageNumber" .Paginator.PageNumber
    "numberOfPages" .Paginator.TotalPages
    "hasPrev" .Paginator.HasPrev
    "hasNext" .Paginator.HasNext
  )
| jsonify -}}
