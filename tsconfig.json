{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    ".astro/env.d.ts",
    "src/**/*",
    "integrations/**/*",
    "scripts/**/*",
    "deploy/**/*",
    "tests/**/*",
    "tina/**/*",
    "packages/product-definition/src/**/*",
    "packages/pricing/src/**/*",
    "*.ts",
    "stylelint.config.mjs",
    "astro.config.ts",
    "eslint.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "tina/__generated__", "public/admin", "old"],
  "compilerOptions": {
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@/*": ["./src/*"],
      "@babasarok/product-definition": ["./packages/product-definition/src/index.ts"],
      "@babasarok/pricing": ["./packages/pricing/src/index.ts"]
    }
  }
}
