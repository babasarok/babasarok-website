{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    ".astro/env.d.ts",
    "src/**/*",
    "integrations/**/*",
    "scripts/**/*",
    "deploy/**/*",
    "eslint/**/*",
    "tests/**/*",
    "tina/**/*",
    "*.ts",
    "stylelint.config.mjs",
    "astro.config.ts",
    "eslint.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "tina/__generated__", "public/admin", "old"],
  "compilerOptions": {
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@/*": ["./src/*"],
      // Shared schemas/pricing/asset presets as TypeScript source, so no CJS
      // dist enters the browser graph.
      "@babasarok/product-definition": ["./backend/src/shared/product-definition/index.ts"],
      "@babasarok/pricing": ["./backend/src/shared/pricing/index.ts"],
      "@babasarok/asset-presets": ["./backend/src/shared/asset-presets.ts"]
    }
  }
}
