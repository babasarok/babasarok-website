{
  "name": "babasarok-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "tinacms build -c \"astro build\"",
    "build:local": "tinacms build --local --skip-cloud-checks -c \"astro build\"",
    "build:search": "tinacms search-index",
    "migrate": "node scripts/migrate/index.ts",
    "preview": "astro preview",
    "astro": "astro",
    "test:dist-tina-urls": "node scripts/test/no-tina-cloud-urls.ts",
    "test:hydration": "playwright test",
    "check": "npx astro check && npx sv check",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.astro,.svelte",
    "lint:style": "stylelint \"**/*.{css,astro,svelte}\"",
    "format": "prettier --write ."
  },
  "imports": {
    "#global.css": "./src/styles/global.css"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^8.1.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@iconify-json/tabler": "^1.2.35",
    "@iconify/svelte": "^5.2.2",
    "@skeletonlabs/floating-ui-svelte": "^0.3.9",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tinacms/astro": "^0.5.0",
    "astro": "^6.4.4",
    "astro-icon": "^1.1.5",
    "astro-md-2": "^2.0.0",
    "clsx": "^2.1.1",
    "sharp": "^0.34.5",
    "svelte-bricks": "^0.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.39.4",
    "@iconify-json/fa": "^1.2.2",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/streamline-logos": "^1.2.0",
    "@playwright/test": "^1.61.1",
    "@tinacms/cli": "^2.5.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-svelte": "^3.20.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stylelint": "^17.14.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "sv": "^0.16.1",
    "svelte-check": "^4.7.1",
    "tinacms": "^3.9.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "yaml": "^2.6.0"
  },
  "overrides": {
    "vite": "^7",
    "@tinacms/cli": {
      "vite": "^4.5.9"
    }
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.18.20": true,
    "esbuild@0.27.7": true,
    "esbuild@0.24.2": true,
    "core-js@2.6.12": true,
    "core-js@3.49.0": true
  }
}
