{
    "name": "babasarok-website",
    "description": "Babasarok weboldal",
    "version": "1.5.8",
    "type": "module",
    "browserslist": [
        "defaults"
    ],
    "repository": "https://github.com/AminZibayi/Corporio",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": {
        "name": "Attila Greguss"
    },
    "scripts": {
        "init": "shx rm -rf .git && git init -b main",
        "create": "hugo new",
        "prestart": "npm run clean",
        "vite": "vite -c vite.config.ts",
        "start": "concurrently \"hugo server --logLevel debug --bind=0.0.0.0 --disableFastRender --baseURL=http://localhost --templateMetrics --templateMetricsHints\" \"vite build --watch\"",
        "start:lan": "hugo server --bind=0.0.0.0 --baseURL=http://192.168.1.10 --port=1313",
        "tina:dev": "tinacms dev -c \"npm start\"",
        "tina:build": "tinacms build && hugo --gc --minify && vite build",
        "prebuild": "npm run clean",
        "build": "hugo --gc --minify",
        "build:lan": "hugo --gc --minify --baseURL=http://192.168.1.10:8080",
        "build:preview": "npm run build -D -F",
        "clean": "shx rm -rf public",
        "clean:git": "git branch --merged master | grep -v '^[ *]*master$' | xargs git branch -d",
        "lint": "npm run -s lint:markdown",
        "lint:markdown": "markdownlint-cli2 \"*.md\" \"content/**/*.md\"",
        "lint:markdown-fix": "markdownlint-cli2-fix \"*.md\" \"content/**/*.md\"",
        "server": "hugo server",
        "test": "npm run -s lint",
        "env": "env",
        "precheck": "npm version",
        "check": "hugo version",
        "latest:hugo": "gh release view --repo gohugoio/hugo",
        "latest:hyas": "gh release view --repo h-enk/hyas",
        "version": "auto-changelog -p && git add CHANGELOG.md"
    },
    "dependencies": {
        "@hyas/images": "^0.2.3",
        "@tailwindcss/vite": "^4.2.2",
        "bootstrap": "^4.6.2",
        "gsap": "1.20.5",
        "iconify-icon": "^3.0.0",
        "imagesloaded": "^5.0.0",
        "jquery": "^3.6.1",
        "lazysizes": "^5.3.2",
        "magnific-popup": "github:dimsemenov/Magnific-Popup",
        "quicklink": "^3.0.1",
        "react-tinacms-editor": "^0.53.26",
        "tailwindcss": "^4.2.2",
        "tinacms": "^3.6.3",
        "waypoints": "^4.0.1"
    },
    "devDependencies": {
        "@babel/cli": "^7.18.10",
        "@babel/core": "^7.19.1",
        "@babel/preset-env": "^7.19.1",
        "@fullhuman/postcss-purgecss": "^4.1.3",
        "@iconify/svelte": "^5.2.1",
        "@skeletonlabs/floating-ui-svelte": "^0.3.9",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tinacms/cli": "^2.1.5",
        "auto-changelog": "^2.4.0",
        "autoprefixer": "^10.4.11",
        "concurrently": "^9.2.1",
        "exec-bin": "^1.0.0",
        "hugo-extended": "^0.155.3",
        "markdownlint-cli2": "^0.5.1",
        "postcss": "^8.4.16",
        "postcss-cli": "^10.0.0",
        "pretty-quick": "^3.1.3",
        "purgecss-whitelister": "^2.4.0",
        "shx": "^0.3.4",
        "svelte": "^5.55.1",
        "typescript": "^6.0.2",
        "uuid": "^13.0.0",
        "vite": "^8.0.3"
    }
}
