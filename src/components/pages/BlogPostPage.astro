---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Base from "@/layouts/Base.astro";
import FloatingShapes from "@/components/ui/FloatingShapes.astro";
import { createI18n } from "@/lib/i18next";
import { localeFromPathname, localizedPath } from "@/lib/i18n";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const locale = localeFromPathname(Astro.url.pathname);
const i18n = createI18n(locale);
const t = i18n.t.bind(i18n);

const { title, date, categories } = post.data;
const feature = post.data.postImage ?? post.data.featureImage;

const tags = Array.isArray(post.data.tags)
  ? post.data.tags
  : post.data.tags
    ? [post.data.tags]
    : [];

const dateFormatter = new Intl.DateTimeFormat(locale === "en" ? "en-GB" : "hu-HU", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const homeHref = localizedPath("/", locale);
const blogHref = localizedPath("/blog", locale);
---

<Base title={title} isArticle data-pagefind-meta={`section:blog`}>
  <header class="relative pt-30 lg:pt-50">
    <FloatingShapes />

    <div class="container">
      <div class="text-center lg:mx-auto lg:w-10/12">
        <h1 class="text-h1 text-headings mb-7.5 text-3xl leading-none lg:text-5xl">{title}</h1>
        <nav aria-label="breadcrumb" class="flex justify-center">
          <ol class="flex items-center whitespace-nowrap">
            <li>
              <a class="text-accent no-underline hover:underline" href={homeHref}>
                {t("pages.home")}
              </a>
            </li>
            <li class="before:mx-2 before:content-['-']">
              <a class="text-accent no-underline hover:underline" href={blogHref}>
                {t("pages.all")}
              </a>
            </li>
            <li class="text-accent before:mx-2 before:content-['-']" aria-current="page">
              {title}
            </li>
          </ol>
        </nav>
      </div>

      <ul class="text-body mt-6 flex flex-wrap justify-center gap-x-7.5 gap-y-2">
        {
          date && (
            <li class="flex items-center gap-2">
              <Icon name="tabler:calendar" class="text-sand-300" />
              {dateFormatter.format(date)}
            </li>
          )
        }
        {
          tags.length > 0 && (
            <li class="flex items-center gap-2">
              <Icon name="tabler:tag" class="text-sand-300" />
              {tags.join(", ")}
            </li>
          )
        }
        {
          categories && (
            <li class="flex items-center gap-2">
              <Icon name="tabler:folder" class="text-sand-300" />
              {categories}
            </li>
          )
        }
      </ul>
    </div>
  </header>

  <section class="relative overflow-hidden py-12.5 sm:py-25">
    <div class="container">
      {
        feature && (
          <div class="mb-12.5 overflow-hidden rounded-[20px]">
            <Image
              src={feature}
              alt={title}
              widths={[480, 768, 960, 1152, 1536]}
              sizes="(min-width: 1200px) 1140px, 100vw"
              class="w-full object-cover"
            />
          </div>
        )
      }

      <div class="prose mx-auto max-w-none">
        <Content />
      </div>
    </div>
  </section>
</Base>
