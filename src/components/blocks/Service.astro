---
import { Image } from "astro:assets";
import { Markdown } from "astro-md-2";
import service from "../../content/sections/service.json";
import { resolveImage } from "../../lib/assets";
import patternSvg from "../../assets/images/service/background-pattern.svg?url";
import TopTitle from "../ui/TopTitle.astro";

const { enable, topTitle, title, service: items } = service;
---

{
  enable && (
    <section
      id="service"
      class="relative overflow-visible py-25 pb-68.75"
    >
      {/* Light background shape (top-right) */}
      <div class="absolute top-0 right-0 -z-10 w-[61%]">
        <svg viewBox="0 0 1283 1126" class="h-auto w-full">
          <path
            class="fill-bg-light"
            d="M100 0h1183v1126l-1183-80A100 100 0 010 946V100A100 100 0 01100 0z"
          />
        </svg>
      </div>

      {/* Soft gradient blob (desktop only) */}
      <div class="absolute bottom-[-10%] left-[-7%] hidden h-116.25 w-102.5 lg:block">
        <svg viewBox="0 0 550 550" class="h-full w-full">
          <defs>
            <linearGradient
              id="service-blob"
              x1="0.209"
              y1="0.085"
              x2="1.071"
              y2="1.164"
              gradientUnits="objectBoundingBox"
            >
              <stop offset="0" stop-color="var(--color-bg-light)" />
              <stop offset="1" stop-color="var(--color-bg-light)" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path
            fill="url(#service-blob)"
            d="M455.4 151.1c43.1 36.7 73.4 92.8 60.8 136.3-12.7 43.5-68.1 74.4-111.3 119.4-43.1 45-74 104.1-109.8 109-35.9 5-76.7-44.2-111.8-89.2-35.2-45-64.7-85.8-70.8-132.6-6-46.8 11.6-99.6 46.7-136.3 35.2-36.6 88-57.2 142.4-58.8 54.5-1.7 110.6 15.6 153.8 52.2z"
          />
        </svg>
      </div>

      {/* Animated dotted pattern (desktop only) */}
      <div class="absolute bottom-[4%] left-[6%] hidden animate-float-y lg:block">
        <img src={patternSvg} alt="" />
      </div>

      <div class="container">
        <div class="lg:w-1/2">
          <div class="mb-12">
            <TopTitle class="block text-dark sm:text-xl">{topTitle}</TopTitle>
            <Markdown of={title} />
          </div>
        </div>

        <div class="w-full">
          <div
            id="service-slider"
            class="service__slider flex snap-x snap-mandatory scroll-smooth overflow-x-scroll"
          >
            {items.map((item) => {
              const img = resolveImage(item.image);
              return (
                <div class="w-[33%] shrink-0 snap-always snap-center p-3.75 max-sm:w-full">
                  <div class="rounded-[20px] bg-white p-7.5 shadow-[0_5px_10px_0_rgba(50,65,141,0.12)]">
                    <div class="relative h-27.5 w-31.25">
                      <div class="absolute top-0 right-0">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="122.457"
                          height="109.702"
                          viewBox="0 0 122.457 109.702"
                        >
                          <path
                            class="fill-bg-light"
                            d="M49.855527 9.984102c-4.337424-.815024-8.766002-1.633779-13.152776-1.113889-8.196034.975107-15.344329 6.696991-19.41555 13.879649s-5.363288 15.655094-5.187042 23.907191c.156996 7.385448 1.479849 14.875357 4.972905 21.38465s9.337384 11.961229 16.458344 13.922244c4.833752 1.331211 10.056683 1.044827 14.74081 2.829827 7.560693 2.881382 12.209757 10.489626 19.01235 14.870016a25.650039 25.650039 0 0024.16316 1.698928c8.342551-3.846451 14.03857-12.107291 16.641338-20.918947s2.471077-18.187687 1.756125-27.346305c-.843101-10.912846-3.01686-22.783019-11.354287-29.869462-6.037066-5.130853-14.208558-6.772976-21.995428-8.235353z"
                          />
                        </svg>
                      </div>
                      <div class="absolute bottom-0 left-0 z-1">
                        {img && (
                          <Image
                            src={img}
                            alt=""
                            width={168}
                            height={168}
                            class="h-21 w-21 object-contain [clip-path:circle()]"
                          />
                        )}
                      </div>
                    </div>
                    <div class="service-item-content mt-12">
                      <Markdown of={item.content} />
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <ul id="service-indicator" class="slick-dots mt-12">
          {items.map(() => (
            <li>
              <button type="button" aria-label="Ugrás a termékre" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<script>
  import { ScrollSnapper } from "../../lib/scrollSnapper";

  const slider = document.getElementById("service-slider");
  const indicator = document.getElementById("service-indicator");
  if (slider && indicator) new ScrollSnapper(slider, indicator);
</script>

<style>
  /* Hide the scrollbar on the snap slider (ported from old SCSS). */
  .service__slider {
    scrollbar-width: none;
  }
  .service__slider::-webkit-scrollbar {
    display: none;
  }

  /* Justify the markdown-rendered product copy. The `<Markdown>` output is not
     scoped to this component, so target it globally within the wrapper. */
  .service-item-content :global(p) {
    text-align: justify;
  }

  /* Dot indicator (ported from the old slick-dots styling). The active state
     is toggled by ScrollSnapper via the `.slick-active` class. */
  .slick-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .slick-dots li {
    height: 8px;
    width: 8px;
  }
  .slick-dots li:not(:last-child) {
    margin-right: 15px;
  }
  .slick-dots li button {
    display: block;
    height: 100%;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-indicator);
    text-indent: -9999px;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .slick-dots li button:hover {
    background: var(--color-primary);
  }
  .slick-dots li button:focus {
    outline: 0;
  }
  .slick-dots li.slick-active {
    height: 10px;
    width: 10px;
  }
  .slick-dots li.slick-active button {
    background: var(--color-primary);
  }
</style>
