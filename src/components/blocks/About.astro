---
import { Image } from "astro:assets";
import { Markdown } from "astro-md-2";
import about from "../../content/sections/about.json";
import { resolveImage } from "../../lib/assets";
import figureSvg from "../../assets/images/hero/figure-svg.svg?url";
import Button from "../ui/Button.astro";

const { enable, title, content, button1Name, button1Target, button2Name, button2Target, image } =
  about;

const aboutImage = resolveImage(image);
const button1Href = button1Target ? `/${button1Target}` : undefined;
const button2Href = button2Target ? `/${button2Target}` : undefined;
---

{
  enable && (
    <section id="about" class="overflow-visible py-25">
      <div class="container">
        {/* Section title (centered) */}
        <div class="prose mb-12 text-center lg:mx-auto lg:w-1/2">
          <Markdown of={title} />
        </div>

        {/* Image + content card */}
        <div class="flex flex-wrap items-center justify-center">
          {/* Image with decorative floating svg + svg mask */}
          <div class="relative w-[45%] max-lg:w-full">
            <div class="animate-float-y absolute top-[-11%] left-[-17%] -z-10 h-37.5 max-md:top-[-7%] max-md:left-[-16%]">
              <img src={figureSvg} alt="" class="h-full w-full" />
            </div>

            {aboutImage && (
              <Image
                src={aboutImage}
                alt=""
                widths={[600, 900, 1200, 1500]}
                sizes="(max-width: 991px) 100vw, 45vw"
                class="about-photo h-full w-full"
              />
            )}
          </div>

          {/* Dark content card */}
          <div class="bg-bg-dark relative -ml-3.75 w-[55%] rounded-[20px] px-12.5 py-15 max-lg:mt-7.5 max-lg:ml-0 max-lg:w-full max-lg:p-6.25">
            {/* Soft gradient blob behind the card (tablet+ only) */}
            <div class="absolute top-[-55%] right-[-22%] -z-10 h-[362.909px] w-[400.369px] max-md:hidden">
              <svg viewBox="0 0 600 600" class="w-[140%]">
                <defs>
                  <linearGradient
                    id="about-blob"
                    x1="0.929"
                    y1="0.111"
                    x2="0.263"
                    y2="0.935"
                    gradientUnits="objectBoundingBox"
                  >
                    <stop offset="0" stop-color="var(--color-bg-light)" />
                    <stop offset="1" stop-color="var(--color-bg-light)" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <path
                  fill="url(#about-blob)"
                  d="M455.4 151.1c43.1 36.7 73.4 92.8 60.8 136.3-12.7 43.5-68.1 74.4-111.3 119.4-43.1 45-74 104.1-109.8 109-35.9 5-76.7-44.2-111.8-89.2-35.2-45-64.7-85.8-70.8-132.6-6-46.8 11.6-99.6 46.7-136.3 35.2-36.6 88-57.2 142.4-58.8 54.5-1.7 110.6 15.6 153.8 52.2z"
                />
              </svg>
            </div>

            <div class="prose about-content mb-4">
              <Markdown of={content} />
            </div>

            <div class="flex flex-wrap gap-4">
              <Button href={button1Href} size="lg" primary>
                {button1Name}
              </Button>
              <Button href={button2Href} size="lg" variant="outline">
                {button2Name}
              </Button>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  /* SVG-shape mask on the about photo (old `-webkit-mask` inline style). */
  .about-photo {
    mask: url("../../assets/images/about/about-mask-svg.svg") center / contain no-repeat;
  }

  /* The content card sits on a dark background, so make the markdown-rendered
     copy light (old Bootstrap `.text-light { h1..h6, p { color } }`). */
  /* stylelint-disable-next-line selector-pseudo-class-no-unknown -- this is valid */
  .about-content :global(:where(h1, h2, h3, h4, h5, h6, p)) {
    color: var(--color-light);
  }
</style>
