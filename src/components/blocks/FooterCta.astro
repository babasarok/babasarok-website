---
import Button from "../ui/Button.astro";

interface Props {
  topTitle: string | null | undefined;
  title: string | null | undefined;
  button: string | null | undefined;
  href: string;
}

const { topTitle, title, button, href } = Astro.props;
---

<div
  class="bg-sand-300 relative z-5 -mt-27.5 flex flex-wrap items-end overflow-hidden rounded-[20px] px-10 py-17.5 lg:px-20 lg:py-25"
>
  <!-- decorative shape 1 -->
  <div class="absolute top-[-43%] left-[2%] z-[-1] rotate-[-20deg]">
    <svg xmlns="http://www.w3.org/2000/svg" width="357" height="315.029" viewBox="0 0 357 315.029">
      <path
        fill="white"
        fill-opacity="0.07"
        data-name="Path 1449"
        d="M76.1-157.222C91.746-135.8 87.2-94.273 99.993-61.945c12.7 32.328 42.661 55.459 39.248 73.282-3.318 17.823-40.007 30.337-65.6 43.325-25.5 12.988-39.912 26.545-60.01 42.566-20.1 16.116-46.074 34.6-63.328 27.682-17.349-6.921-25.976-39.153-59.915-59.82s-93.1-29.768-105.325-51.478 22.373-56.028 43.609-93.949c21.331-37.921 29.2-79.35 53.563-96.793 24.459-17.444 65.414-10.9 103.9-6.921 38.396 3.982 74.326 5.404 89.965 26.829z"
        transform="translate(217.489 188.626)"></path>
    </svg>
  </div>
  <!-- decorative shape 2 -->
  <div class="absolute top-[12%] right-[-9%] z-[-1] h-52 w-58.75 rotate-80">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="357"
      height="315.029"
      viewBox="0 0 357 315.029"
      class="h-full w-full"
    >
      <path
        fill="white"
        fill-opacity="0.07"
        data-name="Path 1449"
        d="M76.1-157.222C91.746-135.8 87.2-94.273 99.993-61.945c12.7 32.328 42.661 55.459 39.248 73.282-3.318 17.823-40.007 30.337-65.6 43.325-25.5 12.988-39.912 26.545-60.01 42.566-20.1 16.116-46.074 34.6-63.328 27.682-17.349-6.921-25.976-39.153-59.915-59.82s-93.1-29.768-105.325-51.478 22.373-56.028 43.609-93.949c21.331-37.921 29.2-79.35 53.563-96.793 24.459-17.444 65.414-10.9 103.9-6.921 38.396 3.982 74.326 5.404 89.965 26.829z"
        transform="translate(217.489 188.626)"></path>
    </svg>
  </div>

  <div class="flex w-full flex-col items-center justify-between gap-5 lg:flex-row">
    <div class="text-light text-center lg:text-start">
      <span class="toptitle relative mb-5 ml-10 inline-block text-lg leading-none lg:block">
        {topTitle}
      </span>
      <h2 class="text-h2 font-heading mb-6 text-3xl text-white lg:text-5xl">
        {title}
      </h2>
    </div>
    <Button variant="secondary" size="lg" href={href}>
      {button}
    </Button>
  </div>
</div>

<style>
  .toptitle::before {
    position: absolute;
    content: "";
    height: 2px;
    width: 20px;
    left: -40px;
    top: 50%;
    transform: translateY(-50%);
    background: #fff;
  }
</style>
