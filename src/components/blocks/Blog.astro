---
import { getCollection, getEntry } from "astro:content";
import { Markdown } from "astro-md-2";
import {
  defaultLocale,
  entryIdForLocale,
  entrySlugFromId,
  localeFromEntryId,
  localeFromPathname,
  localizedPath,
} from "@/lib/i18n";
import blogShape from "../../assets/images/blog/blog-shape.svg?url";
import Button from "../ui/Button.astro";
import TopTitle from "../ui/TopTitle.astro";
import BlogCard from "../ui/BlogCard.astro";

// eslint-disable-next-line @typescript-eslint/no-non-null-assertion
const blogSectionEntry = (await getEntry(
  "blogSectionBlock",
  entryIdForLocale(localeFromPathname(Astro.url.pathname), "blog")
))!;
const { enable, topTitle, title, buttonName, buttonTarget } = blogSectionEntry.data;

const locale = localeFromPathname(Astro.url.pathname);
const posts = (await getCollection("blog"))
  .filter((post) => localeFromEntryId(post.id) === locale)
  .toSorted((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 3);

const buttonHref = buttonTarget
  ? locale === defaultLocale
    ? `/${buttonTarget}`
    : `/${locale}/${buttonTarget}`
  : undefined;
---

{
  enable && (
    <section id="blog" class="relative mb-7.5 py-25">
      {/* Rotating decorative shape (desktop only) */}
      <div class="pointer-events-none absolute top-[11%] right-[12%] -z-10 hidden h-75 w-75 lg:block">
        <img src={blogShape} alt="" aria-hidden="true" class="animate-rotate-slow h-full w-full" />
      </div>

      <div class="container">
        {/* Header: title + desktop button */}
        <div class="mb-12 flex flex-wrap items-end">
          <div class="w-full lg:w-1/2">
            <div>
              <TopTitle class="text-dark block whitespace-pre-line sm:text-xl">{topTitle}</TopTitle>
              <div class="prose">
                <Markdown of={title} />
              </div>
            </div>
          </div>
          <div class="hidden w-1/2 justify-end lg:flex">
            <Button href={buttonHref} variant="outline-secondary" size="lg" class="m-3">
              {buttonName}
            </Button>
          </div>
        </div>

        {/* Posts */}
        <div class="flex flex-wrap">
          {posts.map((post) => (
            <BlogCard
              href={localizedPath(`/blog/${entrySlugFromId(post.id)}/`, locale)}
              title={post.data.title}
              image={post.data.featureImage}
              date={post.data.date}
            />
          ))}
        </div>

        {/* Mobile button */}
        <div class="block text-center lg:hidden">
          <Button href={buttonHref} variant="outline-secondary" size="lg">
            {buttonName}
          </Button>
        </div>
      </div>
    </section>
  )
}
