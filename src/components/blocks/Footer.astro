---
import { Icon } from "astro-icon/components";
import FooterCta from "./FooterCta.astro";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { entryIdForLocale, localeFromPathname, localizedPath } from "@/lib/i18n";
import { createI18n } from "@/lib/i18next";

interface Props {
  /** Leaves out the contact call-to-action and tightens the spacing. */
  compact?: boolean;
}

const { compact = false } = Astro.props;

const config = // eslint-disable-next-line @typescript-eslint/no-non-null-assertion
  (await getEntry("config", entryIdForLocale(localeFromPathname(Astro.url.pathname), "config"))!)
    .data;
const footerLogo = config.footerLogo;
const locale = localeFromPathname(Astro.url.pathname);
const contactLink = localizedPath(
  config.contactLink ? `/${config.contactLink}` : "/contact",
  locale
);
const i18n = createI18n(localeFromPathname(Astro.url.pathname));
const t = i18n.t.bind(i18n);

const rawSitemap = config.sitemapMenu ?? [];
const sitemap = rawSitemap
  .filter((item): item is NonNullable<typeof item> => item !== null)
  .toSorted((a, b) => (a.weight ?? 99) - (b.weight ?? 99));

const social = [...(config.social ?? [])]
  .filter((s): s is NonNullable<typeof s> => s !== null)
  .toSorted((a, b) => (a.weight ?? 99) - (b.weight ?? 99));
---

<footer id="contact" class:list={["bg-sand-700 relative block", !compact && "mt-37.5"]}>
  <!-- Diagonal cut matching the bg-main page colour -->
  <div class="absolute top-0 left-0 w-full">
    <svg viewBox="0 0 1920 79" class="fill-sand-50 hidden h-full w-full sm:block">
      <path d="M0 0h1920v79L0 0z" data-name="Path 1450"></path>
    </svg>
  </div>

  <div class="container">
    {
      !compact && (
        <FooterCta
          topTitle={config.footerContact?.topTitle}
          title={config.footerContact?.title}
          button={config.footerContact?.button}
          href={contactLink}
        />
      )
    }

    <!-- ── Widget Row ── -->
    <div
      class:list={[
        "flex flex-wrap text-center lg:text-start",
        compact ? "pt-16 pb-8 lg:pt-20 lg:pb-10" : "py-12.5 lg:py-25",
      ]}
    >
      <!-- Logo -->
      <div class="mb-5 w-full lg:mb-0 lg:w-1/3">
        {
          footerLogo && (
            <Image
              src={footerLogo}
              alt={t("common.logoAlt")}
              width={255}
              loading="lazy"
              decoding="async"
              class="mx-auto h-42.5 w-auto object-contain lg:mx-0"
            />
          )
        }
      </div>

      <!-- Sitemap -->
      <div class="mb-5 w-full lg:mb-0 lg:w-1/3">
        <h4 class="text-h4 font-base text-light mb-4 text-xl">{t("footer.page")}</h4>
        <ul class="m-0 list-none space-y-2 p-0 text-sm">
          {
            sitemap.map((item) => (
              <li>
                <a
                  href={localizedPath(item.url ?? "/", locale)}
                  class="text-light hover:text-light/80"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Address -->
      <div class="w-full lg:w-1/3">
        <h4 class="text-h4 font-base text-light mb-4 text-xl">{t("footer.address")}</h4>
        <ul class="m-0 list-none space-y-2 p-0 text-sm">
          {
            config.address?.phone && (
              <li>
                <a
                  href={`tel:${config.address.phone}`}
                  class="text-light hover:text-light/80 flex items-center justify-center gap-2 lg:justify-start"
                >
                  <Icon name="tabler:phone" class="shrink-0" />
                  {config.address.phone}
                </a>
              </li>
            )
          }
          {
            config.address?.email && (
              <li>
                <a
                  href={`mailto:${config.address.email}`}
                  class="text-light hover:text-light/80 flex items-center justify-center gap-2 lg:justify-start"
                >
                  <Icon name="tabler:mail" class="shrink-0" />
                  {config.address.email}
                </a>
              </li>
            )
          }
          {
            config.address?.address && (
              <li class="text-light flex items-center justify-center gap-2 lg:justify-start">
                <Icon name="tabler:map-pin" class="shrink-0" />
                <span>{config.address.address}</span>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <!-- ── Bottom Bar ── -->
    <div class="flex flex-wrap items-center justify-between border-t border-white/10 py-6">
      <div class="text-light w-full text-center text-sm lg:w-2/3 lg:text-start">
        <p class="m-0">
          {
            config.copyright ??
              `Copyright ${new Date().getFullYear()} - Minden jog fenntartva - Babasarok`
          }
        </p>
      </div>
      {
        social.length > 0 && (
          <div class="mt-4 w-full text-center lg:mt-0 lg:w-1/3 lg:text-end">
            <ul class="m-0 inline-flex list-none gap-4 p-0">
              {social
                .filter((s) => !!s.icon)
                .map((s) => (
                  <li>
                    <a
                      href={s.url ?? "#"}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-light hover:text-light/80 text-xl"
                    >
                      <Icon name={s.icon} />
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</footer>
