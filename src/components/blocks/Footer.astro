---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getConfig } from "../../lib/data";
import { resolveImage } from "../../lib/assets";
import Button from "../ui/Button.astro";

const config = (await getConfig()).data?.config ?? null;
const footerLogo = resolveImage(config?.footerLogo);
const contactLink = config?.contactLink ? `/${config.contactLink}` : "/contact";

const rawSitemap = config?.sitemapMenu ?? [];
const sitemap = rawSitemap
  .filter((item): item is NonNullable<typeof item> => item !== null)
  .sort((a, b) => (a.weight ?? 99) - (b.weight ?? 99));

const social = [...(config?.social ?? [])]
  .filter((s): s is NonNullable<typeof s> => s !== null)
  .sort((a, b) => (a.weight ?? 99) - (b.weight ?? 99));
---

<footer id="contact" class="bg-bg-dark relative mt-37.5 block">
  <!-- Diagonal cut matching the bg-main page colour -->
  <div class="absolute top-0 left-0 w-full">
    <svg viewBox="0 0 1920 79" class="fill-bg-main hidden h-full w-full sm:block">
      <path d="M0 0h1920v79L0 0z" data-name="Path 1450"></path>
    </svg>
  </div>

  <div class="container">
    <!-- ── CTA Box ── -->
    <div
      class="bg-primary relative z-5 -mt-27.5 flex flex-wrap items-end overflow-hidden rounded-[20px] px-10 py-17.5 lg:px-20 lg:py-25"
    >
      <!-- decorative shape 1 -->
      <div class="absolute top-[-43%] left-[2%] z-[-1] rotate-[-20deg]">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="357"
          height="315.029"
          viewBox="0 0 357 315.029"
        >
          <path
            fill="white"
            fill-opacity="0.07"
            data-name="Path 1449"
            d="M76.1-157.222C91.746-135.8 87.2-94.273 99.993-61.945c12.7 32.328 42.661 55.459 39.248 73.282-3.318 17.823-40.007 30.337-65.6 43.325-25.5 12.988-39.912 26.545-60.01 42.566-20.1 16.116-46.074 34.6-63.328 27.682-17.349-6.921-25.976-39.153-59.915-59.82s-93.1-29.768-105.325-51.478 22.373-56.028 43.609-93.949c21.331-37.921 29.2-79.35 53.563-96.793 24.459-17.444 65.414-10.9 103.9-6.921 38.396 3.982 74.326 5.404 89.965 26.829z"
            transform="translate(217.489 188.626)"></path>
        </svg>
      </div>
      <!-- decorative shape 2 -->
      <div class="absolute top-[12%] right-[-9%] z-[-1] h-52 w-58.75 rotate-80">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="357"
          height="315.029"
          viewBox="0 0 357 315.029"
          class="h-full w-full"
        >
          <path
            fill="white"
            fill-opacity="0.07"
            data-name="Path 1449"
            d="M76.1-157.222C91.746-135.8 87.2-94.273 99.993-61.945c12.7 32.328 42.661 55.459 39.248 73.282-3.318 17.823-40.007 30.337-65.6 43.325-25.5 12.988-39.912 26.545-60.01 42.566-20.1 16.116-46.074 34.6-63.328 27.682-17.349-6.921-25.976-39.153-59.915-59.82s-93.1-29.768-105.325-51.478 22.373-56.028 43.609-93.949c21.331-37.921 29.2-79.35 53.563-96.793 24.459-17.444 65.414-10.9 103.9-6.921 38.396 3.982 74.326 5.404 89.965 26.829z"
            transform="translate(217.489 188.626)"></path>
        </svg>
      </div>

      <div class="flex w-full flex-col items-center justify-between gap-5 lg:flex-row">
        <div class="text-light text-center lg:text-start">
          <span class="toptitle relative mb-5 ml-10 inline-block text-lg leading-none lg:block">
            {config?.footerContact?.topTitle}
          </span>
          <h2 class="font-heading mb-0 text-3xl text-white lg:text-5xl">
            {config?.footerContact?.title}
          </h2>
        </div>
        <Button variant="secondary" size="lg" href={contactLink}>
          {config?.footerContact?.button}
        </Button>
      </div>
    </div>

    <!-- ── Widget Row ── -->
    <div class="flex flex-wrap py-12.5 text-center lg:py-25 lg:text-start">
      <!-- Logo -->
      <div class="mb-5 w-full lg:mb-0 lg:w-1/3">
        {
          footerLogo && (
            <Image
              src={footerLogo}
              alt="Babasarok logó"
              width={255}
              class="mx-auto h-42.5 w-auto object-contain lg:mx-0"
            />
          )
        }
      </div>

      <!-- Sitemap -->
      <div class="mb-5 w-full lg:mb-0 lg:w-1/3">
        <h4 class="font-base text-light mb-4 text-xl">Oldal</h4>
        <ul class="m-0 list-none space-y-2 p-0 text-sm">
          {
            sitemap.map((item) => (
              <li>
                <a href={item.url ?? "/"} class="text-light hover:text-light/80">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Address -->
      <div class="w-full lg:w-1/3">
        <h4 class="font-base text-light mb-4 text-xl">Cím</h4>
        <ul class="m-0 list-none space-y-2 p-0 text-sm">
          {
            config?.address?.phone && (
              <li>
                <a
                  href={`tel:${config.address.phone}`}
                  class="text-light hover:text-light/80 flex items-center justify-center gap-2 lg:justify-start"
                >
                  <Icon name="tabler:phone" class="shrink-0" />
                  {config.address.phone}
                </a>
              </li>
            )
          }
          {
            config?.address?.email && (
              <li>
                <a
                  href={`mailto:${config.address.email}`}
                  class="text-light hover:text-light/80 flex items-center justify-center gap-2 lg:justify-start"
                >
                  <Icon name="tabler:mail" class="shrink-0" />
                  {config.address.email}
                </a>
              </li>
            )
          }
          {
            config?.address?.address && (
              <li class="text-light flex items-center justify-center gap-2 lg:justify-start">
                <Icon name="tabler:map-pin" class="shrink-0" />
                <span>{config.address.address}</span>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <!-- ── Bottom Bar ── -->
    <div class="flex flex-wrap items-center justify-between border-t border-white/10 py-6">
      <div class="text-light w-full text-center text-sm lg:w-2/3 lg:text-start">
        <p class="m-0">
          {
            config?.copyright ??
              `Copyright ${new Date().getFullYear()} - Minden jog fenntartva - Babasarok`
          }
        </p>
      </div>
      {
        social.length > 0 && (
          <div class="mt-4 w-full text-center lg:mt-0 lg:w-1/3 lg:text-end">
            <ul class="m-0 inline-flex list-none gap-4 p-0">
              {social
                .filter((s) => s.icon)
                .map((s) => (
                  <li>
                    <a
                      href={s.url ?? "#"}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-light hover:text-light/80 text-xl"
                    >
                      <Icon name={s.icon!} />
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</footer>

<style>
  .toptitle::before {
    position: absolute;
    content: "";
    height: 2px;
    width: 20px;
    left: -40px;
    top: 50%;
    transform: translateY(-50%);
    background: #fff;
  }
</style>
