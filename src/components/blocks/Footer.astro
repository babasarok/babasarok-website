---
import { getConfig } from "../../lib/data";
import Button from "../ui/Button.astro";


const config = (await getConfig()).data?.config ?? null;

---

<footer
 id="contact"
 class="bg-bg-dark relative mt-37.5 block"
>
    <div class="absolute w-full top-0 left-0 ">
        <svg viewBox="0 0 1920 79" class="hidden sm:block fill-bg-main h-full w-full">
            <path d="M0 0h1920v79L0 0z" data-name="Path 1450" />
        </svg>
    </div>
    <div class="w-full px-3.75 mx-auto max-w-135 sm:max-w-180 md:max-w-240">
        <div class="flex flex-wrap">
            <div class="w-full">
                <div class="flex align-items-end flex-wrap bg-primary lg:py-25 lg:px-20 relative rounded-[20px] overflow-hidden z-5 -mt-27.5  py-17.5 px-10">
                    <!-- TODO: animation -->
                    <div class="absolute z-[-1] rotate-[-20deg] top-[-43%] left-[2%] ">
                        <svg xmlns="http://www.w3.org/2000/svg" width="357" height="315.029" viewBox="0 0 357 315.029">
                            <path
                                class="fill-white opacity-7"
                                data-name="Path 1449"
                                d="M76.1-157.222C91.746-135.8 87.2-94.273 99.993-61.945c12.7 32.328 42.661 55.459 39.248 73.282-3.318 17.823-40.007 30.337-65.6 43.325-25.5 12.988-39.912 26.545-60.01 42.566-20.1 16.116-46.074 34.6-63.328 27.682-17.349-6.921-25.976-39.153-59.915-59.82s-93.1-29.768-105.325-51.478 22.373-56.028 43.609-93.949c21.331-37.921 29.2-79.35 53.563-96.793 24.459-17.444 65.414-10.9 103.9-6.921 38.396 3.982 74.326 5.404 89.965 26.829z"
                                transform="translate(217.489 188.626)" />
                        </svg>
                    </div>
                    <!-- TODO: animation -->
                    <div class="absolute z-[-1] rotate-80 top-[12%] right-[-9%] w-58.75 h-52">
                        <svg xmlns="http://www.w3.org/2000/svg" width="357" height="315.029" viewBox="0 0 357 315.029">
                            <path
                                class="fill-white opacity-7"
                                data-name="Path 1449"
                                d="M76.1-157.222C91.746-135.8 87.2-94.273 99.993-61.945c12.7 32.328 42.661 55.459 39.248 73.282-3.318 17.823-40.007 30.337-65.6 43.325-25.5 12.988-39.912 26.545-60.01 42.566-20.1 16.116-46.074 34.6-63.328 27.682-17.349-6.921-25.976-39.153-59.915-59.82s-93.1-29.768-105.325-51.478 22.373-56.028 43.609-93.949c21.331-37.921 29.2-79.35 53.563-96.793 24.459-17.444 65.414-10.9 103.9-6.921 38.396 3.982 74.326 5.404 89.965 26.829z"
                                transform="translate(217.489 188.626)" />
                        </svg>
                    </div>
                    <div class="flex flex-col lg:flex-row w-full justify-between items-center gap-5">


                    <div class="text-light text-center lg:text-start">
                        <span class="toptitle text-lg lg:block leading-none mb-5 ml-10 relative inline-block">{ config.footerContact?.topTitle }</span>
                        <h2 class="mb-0 text-3xl lg:text-5xl font-heading">{ config.footerContact?.title }</h2>
                    </div>
                        <Button variant="secondary" size="lg" href={ config.contactLink ?? undefined }>
                            { config.footerContact?.button }
                        </Button>
                    </div>
                </div>
            </div>
    </div>
</footer>

<style>
    .toptitle::before {
        position: absolute;
        content: "";
        height: 2px;
        width: 20px;
        left: -40px;
        top: 50%;
        transform: translateY(-50%);
        background: #fff;
    }
</style>