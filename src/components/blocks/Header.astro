---
import { getConfig } from "@/lib/data";
import Button from "@/components/ui/Button.astro";

const config = (await getConfig()).data.config;
const logo = config.logo;
const contactLink = config.contactLink ? `/${config.contactLink}` : "/contact";

const isHome = Astro.url.pathname === "/";

const rawMenu = config.mainMenu ?? [];
const mainMenu = rawMenu
  .filter((item): item is NonNullable<typeof item> => item !== null)
  .toSorted((a, b) => (a.weight ?? 99) - (b.weight ?? 99));
---

<nav id="navbar" class="fixed top-0 z-50">
  <div class="container">
    <div class="flex flex-wrap items-center justify-between">
      <a href="/" class="block shrink-0">
        {
          logo && (
            <img
              src={logo}
              alt="Babasarok logó"
              width={200}
              loading="lazy"
              decoding="async"
              class="h-17.5 w-auto shrink-0 object-contain lg:w-25"
            />
          )
        }
      </a>

      <button
        id="navbar-toggler"
        type="button"
        aria-label="Menü"
        aria-controls="navbar-collapse"
        aria-expanded="false"
        class="flex cursor-pointer flex-col gap-1.25 border-0 bg-transparent p-0 lg:hidden"
      >
        <span class="toggler-bar"></span>
        <span class="toggler-bar"></span>
        <span class="toggler-bar"></span>
      </button>

      <div id="navbar-collapse" class="w-full">
        <ul class="mx-auto my-0 flex flex-col items-center gap-2 py-4 lg:flex-row lg:py-0">
          {
            mainMenu.map((item) => (
              <li>
                <a
                  href={item.url ?? "/"}
                  class:list={[
                    "text-dark hover:text-sand-300 block p-2 text-center transition-all",
                    isHome && item.url?.includes("#") && "scroll",
                  ]}
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="flex justify-center pb-4 lg:pb-0">
          <Button href={contactLink} size="lg" variant="primary">Rendelés</Button>
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  /* ── All screens: base positioning + transition ─────────────── */
  #navbar {
    left: 0;
    right: 0;
    background-color: #fff;
    padding: 15px 20px;
    border-radius: 5px;

    /* Transition only the properties that actually change */
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease,
      padding-top 0.3s ease,
      padding-bottom 0.3s ease,
      left 0.3s ease,
      right 0.3s ease,
      top 0.3s ease;
  }

  /* ── Mobile scrolled: floating card, no overflow ─────────────── */

  /* left/right with no explicit width = element fills the gap, fully animatable */
  #navbar.scrolled {
    top: 10px;
    left: 10px;
    right: 10px;
    box-shadow: 0 10px 20px 0 rgb(50 65 141 / 10%);
  }

  /* ── Desktop: transparent→white on scroll ────────────────────── */

  /* rgb(255 255 255 / 0%) keeps the colour channel white so the transition
	   fades opacity only — no dark intermediate frames */
  @media (width >= 1024px) {
    #navbar {
      background-color: rgb(255 255 255 / 0%);
      padding: 20px 0;
      border-radius: 0;
    }

    #navbar.scrolled {
      top: 0;
      left: 0;
      right: 0;
      background-color: rgb(255 255 255 / 100%);
      padding-top: 10px;
      padding-bottom: 10px;
      box-shadow: 0 10px 20px 0 rgb(50 65 141 / 10%);
    }
  }

  /* ── Hamburger bars ──────────────────────────────────────────── */
  .toggler-bar {
    display: block;
    height: 2px;
    width: 25px;
    background: var(--color-sand-300);
    transition: all 0.2s;
  }

  #navbar-toggler[aria-expanded="true"] .toggler-bar:nth-child(1) {
    transform: rotate(45deg);
    transform-origin: 10% 10%;
  }

  #navbar-toggler[aria-expanded="true"] .toggler-bar:nth-child(2) {
    opacity: 0;
  }

  #navbar-toggler[aria-expanded="true"] .toggler-bar:nth-child(3) {
    transform: rotate(-45deg);
    transform-origin: 10% 90%;
  }

  /* ── Mobile collapse animation ───────────────────────────────── */
  #navbar-collapse {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-in-out;
  }

  /* Desktop: always visible, flex layout */
  @media (width >= 1024px) {
    #navbar-collapse {
      max-height: none !important;
      overflow: visible;
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const navbar = document.getElementById("navbar");
    const toggler = document.getElementById("navbar-toggler");
    const collapse = document.getElementById("navbar-collapse");

    // ── Scroll behaviour ───────────────────────────────────────────
    function reactToScroll() {
      if (!navbar) return;
      navbar.classList.toggle("scrolled", document.documentElement.scrollTop > 200);
    }
    window.addEventListener("scroll", reactToScroll, { passive: true });
    reactToScroll();

    // ── Mobile menu toggle with animation ─────────────────────────
    toggler?.addEventListener("click", () => {
      if (!collapse || !toggler) return;
      const isOpen = collapse.style.maxHeight !== "" && collapse.style.maxHeight !== "0px";
      if (isOpen) {
        collapse.style.maxHeight = "0";
        toggler.setAttribute("aria-expanded", "false");
      } else {
        collapse.style.maxHeight = collapse.scrollHeight + "px";
        toggler.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
