---
import { getEntry } from "astro:content";
import { Markdown } from "astro-md-2";
import productSection from "../../content/sections/product.json";
import Button from "../ui/Button.astro";
import ProductCard from "../ui/ProductCard.astro";

const {
  enable,
  title,
  itemCount,
  buttonName,
  buttonTarget,
  products: productList,
} = productSection;

let products = [];
for (const productRef of productList) {
  if (!productRef.product) {
    continue;
  }

  const id = productRef.product.split("/").pop()?.split(".")[0];

  if (!id) {
    continue;
  }

  const entry = await getEntry("product", id);
  if (entry) {
    products.push(entry);
  }
}

products = products.slice(0, itemCount);

const buttonHref = buttonTarget ? `/${buttonTarget}` : undefined;
---

{
  enable && (
    <section id="product" class="pt-25 pb-25 lg:pb-33.75">
      <div class="container">
        {/* Section title (centered) */}
        <div class="prose mb-12 text-center lg:mx-auto lg:w-1/2">
          <Markdown of={title} />
        </div>

        {/* Product grid */}
        <div class="flex flex-wrap justify-center gap-8 gap-y-12 sm:gap-y-8">
          {products.map((product) => (
            <ProductCard
              href={`/product/${product.id}/`}
              title={product.data.title}
              image={product.data.thumbnail ?? undefined}
              category={product.data.categories ?? undefined}
              square
            />
          ))}
        </div>

        {/* All-products button */}
        <div class="mt-4 flex justify-center">
          <Button href={buttonHref} variant="primary" size="lg">
            {buttonName}
          </Button>
        </div>
      </div>
    </section>
  )
}
