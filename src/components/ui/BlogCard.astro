---
import { Image } from "astro:assets";

interface Props {
  href: string;
  title: string;
  image?: ImageMetadata | undefined;
  date?: Date | undefined;
  /** "preview" = landing blog grid, "page" = blog list page (wider spacing). */
  spacing?: "preview" | "page";
}

const { href, title, image, date, spacing = "preview" } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<div class="w-1/3 px-3.75 max-lg:w-full">
  <div
    class:list={[
      "group relative",
      spacing === "page" ? "mb-45" : "mb-5 max-lg:mb-32.5",
    ]}
  >
    <div class="w-[90%] overflow-hidden rounded-[20px] max-lg:mx-auto max-lg:w-[80%]">
      {
        image && (
          <Image
            src={image}
            alt={title}
            widths={[320, 480, 640, 768, 960, 1152, 1536]}
            sizes="(min-width: 992px) 342px, (min-width: 768px) 70vw, 80vw"
            class="aspect-320/370 w-full object-cover transition-all duration-300 group-hover:scale-110"
          />
        )
      }
    </div>
    <div class="absolute -bottom-25 left-10 rounded-[20px] bg-white p-7.5 shadow-[0_20px_40px_0_rgba(50,65,141,0.12)] max-lg:left-0">
      {
        date && (
          <span class="relative mb-5 ml-10 block leading-none text-primary before:absolute before:top-1/2 before:-left-10 before:h-px before:w-5 before:-translate-y-1/2 before:bg-accent before:content-['']">
            {dateFormatter.format(date)}
          </span>
        )
      }
      <h5 class="mb-0">
        <a class="text-dark hover:text-primary" href={href}>{title}</a>
      </h5>
    </div>
  </div>
</div>
