---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  href: string;
  title: string;
  image?: ImageMetadata | undefined;
  date?: Date | undefined;
  /** "preview" = landing blog grid, "page" = blog list page (wider spacing). */
  spacing?: "preview" | "page";
}

const { href, title, image, date, spacing = "preview" } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<div class="w-full px-3.75 lg:w-1/3">
  <div class:list={["group relative", spacing === "page" ? "mb-45" : "mb-32.5 lg:mb-5"]}>
    <div class="mx-auto w-[80%] overflow-hidden rounded-[20px] lg:mx-0 lg:w-[90%]">
      {
        image && (
          <Image
            src={image}
            alt={title}
            widths={[320, 480, 640, 768, 960, 1152, 1536]}
            sizes="(min-width: 992px) 342px, (min-width: 768px) 70vw, 80vw"
            class="aspect-320/370 w-full object-cover transition-all duration-300 group-hover:scale-110"
          />
        )
      }
    </div>
    <div
      class="absolute -bottom-25 left-0 rounded-[20px] bg-white p-7.5 shadow-[0_20px_40px_0_rgba(50,65,141,0.12)] lg:left-10"
    >
      {
        date && (
          <span class="text-sand-300 before:bg-accent relative mb-5 ml-10 block leading-none before:absolute before:top-1/2 before:-left-10 before:h-px before:w-5 before:-translate-y-1/2 before:content-['']">
            {dateFormatter.format(date)}
          </span>
        )
      }
      <h5 class="text-h5 mb-0">
        <a class="text-dark hover:text-sand-300" href={href}>{title}</a>
      </h5>
    </div>
  </div>
</div>
