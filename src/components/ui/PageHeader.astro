---
import figureSvg from "../../assets/images/hero/figure-svg.svg?url";
import patternSvg from "../../assets/images/service/background-pattern.svg?url";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="relative pt-50 max-lg:pt-30">
  {/* Floating figure (desktop only) */}
  <div class="absolute bottom-[-35%] left-[-7%] animate-float-y max-lg:hidden">
    <img src={figureSvg} alt="" />
  </div>

  {/* Soft gradient blob (desktop only) */}
  <div class="absolute right-[2%] bottom-[-60%] h-75 w-75 max-lg:hidden">
    <svg viewBox="0 0 600 600" class="w-full">
      <defs>
        <linearGradient
          id="breadcrumb-blob"
          x1="0.929"
          y1="0.111"
          x2="0.263"
          y2="0.935"
          gradientUnits="objectBoundingBox"
        >
          <stop offset="0" stop-color="var(--color-bg-light)"></stop>
          <stop offset="1" stop-color="var(--color-bg-light)" stop-opacity="0"
          ></stop>
        </linearGradient>
      </defs>
      <path
        fill="url(#breadcrumb-blob)"
        d="M455.4 151.1c43.1 36.7 73.4 92.8 60.8 136.3-12.7 43.5-68.1 74.4-111.3 119.4-43.1 45-74 104.1-109.8 109-35.9 5-76.7-44.2-111.8-89.2-35.2-45-64.7-85.8-70.8-132.6-6-46.8 11.6-99.6 46.7-136.3 35.2-36.6 88-57.2 142.4-58.8 54.5-1.7 110.6 15.6 153.8 52.2z"
      ></path>
    </svg>
  </div>

  {/* Animated dotted pattern (desktop only) */}
  <div
    class="absolute right-[10%] bottom-[-40%] h-25 w-25 animate-float-y max-lg:hidden"
  >
    <img src={patternSvg} alt="" class="h-full w-full" />
  </div>

  <div class="container">
    <div class="text-center">
      <h1 class="mb-7.5 text-5xl leading-none max-lg:text-3xl">{title}</h1>
      <nav aria-label="breadcrumb" class="flex justify-center">
        <ol class="flex items-center whitespace-nowrap">
          <li>
            <a class="text-accent no-underline hover:underline" href="/">
              Főoldal
            </a>
          </li>
          <li
            class="text-accent before:mx-2 before:content-['-']"
            aria-current="page"
          >
            {title}
          </li>
        </ol>
      </nav>
    </div>
  </div>
</header>
