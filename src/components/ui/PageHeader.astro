---
import FloatingShapes from "./FloatingShapes.astro";
import { localeFromPathname, localizedPath } from "../../lib/i18n";
import { createI18n } from "../../lib/i18next";

interface Props {
  title: string;
  breadcrumb?: string;
  "no-shapes"?: boolean;
  /** Reduced vertical rhythm for pages whose main content follows directly. */
  compact?: boolean;
  class?: string;
}

const {
  title,
  breadcrumb = title,
  "no-shapes": noShapes = false,
  compact: compact = false,
  class: className = "",
} = Astro.props;

const locale = localeFromPathname(Astro.url.pathname);
const i18n = createI18n(locale);
const t = i18n.t.bind(i18n);
---

<header class={`relative pt-30 lg:pt-50 ${className}`}>
  {!noShapes && <FloatingShapes />}

  <div class="container">
    <div class="text-center">
      <h1
        class={`text-h1 text-headings leading-none ${
          compact ? "mb-4 text-2xl lg:text-4xl" : "mb-7.5 text-3xl lg:text-5xl"
        }`}
      >
        {title}
      </h1>
      <nav aria-label="breadcrumb" class="flex justify-center">
        <ol class="flex items-center whitespace-nowrap">
          <li>
            <a class="text-accent no-underline hover:underline" href={localizedPath("/", locale)}>
              {t("pages.home")}
            </a>
          </li>
          <li class="text-accent before:mx-2 before:content-['-']" aria-current="page">
            {breadcrumb}
          </li>
        </ol>
      </nav>
    </div>
  </div>
</header>
