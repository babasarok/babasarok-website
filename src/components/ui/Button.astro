---
import { tv, type VariantProps } from "tailwind-variants";
import { cn } from "../../lib/cn";

/**
 * Button styled to match the Bootstrap 4 `.btn` component.
 * Renders an <a> when `href` is provided, otherwise a <button>.
 */
const button = tv({
  base: [
    "inline-block text-center align-middle select-none cursor-pointer shadow-lg",
    "border border-solid font-normal leading-[1.5]",
    "transition-all",
    "hover:scale-[1.03]",
    "focus:outline-none focus:ring-3",
    "disabled:opacity-65 disabled:pointer-events-none",
    "aria-disabled:opacity-65 aria-disabled:pointer-events-none",
  ],
  variants: {
    variant: {
      primary:
        "text-white bg-primary border-primary hover:bg-primary-dark hover:border-primary-dark focus:ring-primary/50",
      secondary:
        "text-white bg-white border-white hover:bg-secondary-dark hover:border-secondary-dark focus:ring-secondary/50 text-primary",
    },
    outline: {
      true: "bg-transparent",
    },
    size: {
      sm: "px-2 py-1 rounded-[0.2rem]",
      md: "px-3 py-[0.375rem] text-base rounded-[0.25rem]",
      lg: "px-6 py-4 rounded-lg text-base",
    },
    block: {
      true: "block w-full",
    },
  },
  compoundVariants: [
    {
      outline: true,
      variant: "primary",
      class:
        "text-primary border-primary hover:text-white hover:bg-primary",
    },
    {
      outline: true,
      variant: "secondary",
      class:
        "text-[#6c757d] border-[#6c757d] hover:text-white hover:bg-[#6c757d]",
    },
  ],
  defaultVariants: {
    variant: "primary",
    size: "md",
  },
});

type ButtonVariants = VariantProps<typeof button>;

interface Props extends ButtonVariants {
  href?: string | undefined;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  type = "button",
  disabled = false,
  variant,
  outline,
  size,
  block,
  class: className,
  ...rest
} = Astro.props;

const classes = cn(button({ variant, outline, size, block }), className);
---

{
  href ? (
    <a
      href={href}
      class={classes}
      role="button"
      aria-disabled={disabled ? "true" : undefined}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} {...rest}>
      <slot />
    </button>
  )
}
