---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  href: string;
  title: string;
  image?: ImageMetadata | undefined;
  category?: string | undefined;
  /** Square, uniform-height variant used by the landing product grid. */
  square?: boolean;
}

const { href, title, image, category, square = false } = Astro.props;
---

<div
  class="group flex w-1/2 max-w-62.5 flex-col p-7.5 max-md:w-full max-md:p-0 max-sm:items-center"
>
  {
    image && (
      <Image
        src={image}
        alt={title}
        widths={[300, 700]}
        sizes="(max-width: 575px) 50vw, 300px"
        class:list={[
          "w-full max-w-75 rounded-[20px] transition-all duration-300 group-hover:shadow-[0_20px_40px_0_rgba(0,0,0,0.12)] max-sm:mx-auto max-sm:max-w-[50vw]",
          square && "aspect-square object-cover",
        ]}
      />
    )
  }
  <div class:list={["flex flex-col max-sm:items-center max-sm:text-center", square && "flex-1"]}>
    {
      category && (
        <span class="text-body mt-7 mb-5 block text-lg leading-none max-sm:mt-3.5 max-sm:mb-2.5 max-sm:text-[0.9rem]">
          {category}
        </span>
      )
    }
    <h3 class="text-h3 text-headings mb-0">
      <a class="text-dark hover:text-primary" href={href}>{title}</a>
    </h3>
    <a
      href={href}
      class="text-primary before:bg-primary relative ml-7.5 inline-block origin-bottom scale-y-0 transition-all duration-300 group-hover:scale-y-100 before:absolute before:top-1/2 before:-left-7.5 before:h-0.5 before:w-5 before:-translate-y-1/2 before:content-[''] max-md:scale-y-100"
    >
      Részletek
    </a>
  </div>
</div>
