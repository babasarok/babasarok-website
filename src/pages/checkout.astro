---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import CheckoutForm from "@/components/blocks/order/CheckoutForm.svelte";
import { getMaterials, getThreadColors } from "@/lib/catalog";
import { getEntry } from "astro:content";

export const prerender = false;

const checkout = await getEntry("checkout", "index");

if (!checkout) {
  throw new Error("Checkout entry not found");
}

const [materials, threadColors] = await Promise.all([getMaterials(), getThreadColors()]);

const labels = {
  materials: Object.fromEntries(
    materials.map((material) => [
      material.slug,
      {
        label: material.label,
        colors: Object.fromEntries(material.colors.map((color) => [color.id, color.label])),
      },
    ])
  ),
  threadColors: Object.fromEntries(threadColors.map((color) => [color.id, color.label])),
};
---

<Base title="Pénztár">
  <PageHeader title="Pénztár" breadcrumb="Pénztár" no-shapes />

  <section class="py-12.5">
    <div class="not-prose container">
      <CheckoutForm
        basketInfo={checkout.data.basket_note}
        contactHeading={checkout.data.contact_heading}
        basketHeading={checkout.data.basket_heading}
        messageHeading={checkout.data.message_heading}
        labels={labels}
        client:load
      />
    </div>
  </section>
</Base>
