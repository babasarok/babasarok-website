---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import CheckoutSection from "@/components/blocks/catalog/CheckoutSection.svelte";
import { entryIdForLocale, localeFromPathname } from "@/lib/i18n";
import { getEntry } from "astro:content";
import { createI18n } from "@/lib/i18next";

const locale = localeFromPathname(Astro.url.pathname);
const i18n = createI18n(locale);
const t = i18n.t.bind(i18n);
const configEntry = await getEntry("config", entryIdForLocale(locale, "config"));
// The glob loader strips a trailing "/index" from the entry id (hu/index.md → hu).
const checkout = await getEntry("checkout", locale);

if (!configEntry) {
  throw new Error("Config entry not found");
}

const config = configEntry.data;

if (!checkout) {
  throw new Error("Checkout entry not found");
}
---

<Base title={t("checkout.title")}>
  <PageHeader title={t("checkout.title")} breadcrumb={t("checkout.title")} no-shapes />

  <section class="py-12.5">
    <div class="not-prose container">
      <CheckoutSection
        {locale}
        basketInfo={checkout.data.basket_note}
        contactHeading={checkout.data.contact_heading}
        basketHeading={checkout.data.basket_heading}
        messageHeading={checkout.data.message_heading}
        supportEmail={config.address?.email}
        client:load
      />
    </div>
  </section>
</Base>
