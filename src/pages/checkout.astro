---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import CheckoutForm from "@/components/blocks/order/CheckoutForm.svelte";
import { getMaterials, getProductGroups, getProducts, getThreadColors } from "@/lib/catalog";
import { setMembersByGroup } from "@/lib/basket/setDiscounts";
import { getEntry } from "astro:content";
import { localeFromPathname } from "../lib/i18n";
import { createI18n } from "../lib/i18next";
const i18n = createI18n(localeFromPathname(Astro.url.pathname));
const t = i18n.t.bind(i18n);

export const prerender = false;

const configEntry = await getEntry("config", "config");
const checkout = await getEntry("checkout", "index");

if (!configEntry) {
  throw new Error("Config entry not found");
}

const config = configEntry.data;

if (!checkout) {
  throw new Error("Checkout entry not found");
}

const [materials, threadColors, products, groups] = await Promise.all([
  getMaterials(),
  getThreadColors(),
  getProducts(),
  getProductGroups(),
]);
const setMembers = setMembersByGroup(groups, products);

const labels = {
  materials: Object.fromEntries(
    materials.map((material) => [
      material.slug,
      {
        label: material.label,
        colors: Object.fromEntries(material.colors.map((color) => [color.id, color.label])),
      },
    ])
  ),
  threadColors: Object.fromEntries(threadColors.map((color) => [color.id, color.label])),
};
---

<Base title={t("checkout.title")}>
  <PageHeader title={t("checkout.title")} breadcrumb={t("checkout.title")} no-shapes />

  <section class="py-12.5">
    <div class="not-prose container">
      <CheckoutForm
        locale={localeFromPathname(Astro.url.pathname)}
        basketInfo={checkout.data.basket_note}
        contactHeading={checkout.data.contact_heading}
        basketHeading={checkout.data.basket_heading}
        messageHeading={checkout.data.message_heading}
        labels={labels}
        setMembers={setMembers}
        supportEmail={config.address?.email}
        client:load
      />
    </div>
  </section>
</Base>
