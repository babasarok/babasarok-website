---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import BlogCard from "../../components/ui/BlogCard.astro";
import Pagination from "../../components/ui/Pagination.astro";
import { resolveImage } from "../../lib/assets";

export const getStaticPaths = (async () => {
  const PAGE_SIZE = 6;
  const posts = (await getCollection("blog")).toSorted(
    (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
  );

  const lastPage = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));

  return Array.from({ length: lastPage }, (_, i) => {
    const currentPage = i + 1;
    return {
      params: { page: currentPage === 1 ? undefined : `page/${currentPage}` },
      props: {
        items: posts.slice(i * PAGE_SIZE, (i + 1) * PAGE_SIZE),
        currentPage,
        lastPage,
      },
    };
  });
}) satisfies GetStaticPaths;

const { items, currentPage, lastPage } = Astro.props;
---

<Base title="Referenciamunkák">
  <PageHeader title="Referenciamunkák" />
  <section class="py-25">
    <div class="container">
      <div class="flex flex-wrap">
        {
          items.map((post) => (
            <BlogCard
              href={`/blog/${post.id}/`}
              title={post.data.title}
              image={resolveImage(post.data.featureImage)}
              date={post.data.date}
              spacing="page"
            />
          ))
        }
      </div>
      <Pagination currentPage={currentPage} lastPage={lastPage} basePath="/blog" />
    </div>
  </section>
</Base>
