---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BlogPostPage from "@/components/pages/BlogPostPage.astro";
import { defaultLocale, entrySlugFromId, localeFromEntryId } from "@/lib/i18n";

export const getStaticPaths = (async () => {
  const posts = (await getCollection("blog"))
    .filter((post) => localeFromEntryId(post.id) === defaultLocale)
    .toSorted((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

  return posts.map((post) => ({
    params: { id: entrySlugFromId(post.id) },
    props: { post },
  }));
}) satisfies GetStaticPaths;
---

<BlogPostPage {...Astro.props} />
