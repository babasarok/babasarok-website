---
// Reads the Vendure catalog for the orderable-product list, so it renders on
// demand (edge-cached) like the other catalog-touching pages (ADR 0012).
export const prerender = false;
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import { getProducts } from "@/lib/catalog";
import { entryIdForLocale, localeFromPathname } from "@/lib/i18n";

const locale = localeFromPathname(Astro.url.pathname);
const terms = await getEntry("terms", entryIdForLocale(locale, "index"));

if (!terms) {
  throw new Error("Terms entry not found");
}

const { Content } = await render(terms);
const { title } = terms.data;

const productTitles = (await getProducts())
  .map((p) => p.name.trim())
  .toSorted((a, b) => a.localeCompare(b, "hu"));
---

<Base title={title}>
  <PageHeader title={title} breadcrumb={title} no-shapes />

  <section class="py-12.5">
    <div class="container">
      <div class="prose mx-auto max-w-none">
        <Content />

        <h2>Megvásárolható termékek listája</h2>
        <ul>
          {productTitles.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>
