---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import OrderableProducts from "../components/blocks/catalog/OrderableProducts.svelte";
import { createI18n } from "@/lib/i18next";
import { localeFromPathname } from "@/lib/i18n";

const locale = localeFromPathname(Astro.url.pathname);
const i18n = createI18n(locale);
const t = i18n.t.bind(i18n);
// The glob loader strips a trailing "/index" from the entry id (hu/index.md → hu).
const terms = await getEntry("terms", locale);

if (!terms) {
  throw new Error("Terms entry not found");
}

const { Content } = await render(terms);
const { title } = terms.data;
---

<Base title={title}>
  <PageHeader title={title} breadcrumb={title} no-shapes />

  <section class="py-12.5">
    <div class="container">
      <div class="prose mx-auto max-w-none">
        <Content />

        <h2>{t("pages.orderableProducts")}</h2>
        <OrderableProducts client:visible {locale} />
      </div>
    </div>
  </section>
</Base>
