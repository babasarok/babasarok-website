---
import Base from '../layouts/Base.astro';
import Hero from '../components/blocks/Hero.astro';
import Service from '../components/blocks/Service.astro';
import { getConfig } from '../lib/data';

const config = (await getConfig()).data?.config ?? null;
---

<Base
	title={config?.titleSeparator
		? `${config.title} ${config.titleSeparator} ${config.titleAddition}`
		: config?.title ?? "Babasarok"}
	description={config?.description}
>
	<Hero />
	<Service />
</Base>
