---
import type { GetStaticPaths, ImageMetadata } from "astro";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Base from "../../layouts/Base.astro";
import FloatingShapes from "../../components/ui/FloatingShapes.astro";
import ProductGallery from "../../components/ui/ProductGallery.astro";

type GalleryImage = {
  src: ImageMetadata;
  alt: string;
  description?: string | undefined;
};

export const getStaticPaths = (async () => {
  const products = (await getCollection("product")).toSorted(
    (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
  );

  return products.map((product, i) => ({
    params: { id: product.id },
    props: {
      product,
      prev: products[i - 1] ?? null,
      next: products[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { product, prev, next } = Astro.props;
const { Content } = await render(product);

const { title, shortDescription, table = [] } = product.data;

const gallery: GalleryImage[] = [];
const thumb = product.data.thumbnail;
if (thumb) {
  gallery.push({ src: thumb, alt: title });
}
for (const entry of product.data.images ?? []) {
  const img = entry?.image;
  if (img) {
    gallery.push({ src: img, alt: title, description: entry?.description ?? undefined });
  }
}

const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const shareLinks = [
  {
    icon: "fa-brands:facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`,
  },
  {
    icon: "fa-brands:linkedin",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`,
  },
  {
    icon: "fa-brands:twitter",
    href: `https://twitter.com/intent/tweet?&url=${shareUrl}`,
  },
];
---

<Base title={title} description={shortDescription} isArticle>
  <section class="relative overflow-hidden pt-30 pb-25 sm:pt-50">
    <FloatingShapes
      figureClass="top-[30%] left-[-7%]"
      blobClass="right-[4%] top-[29%]"
      patternClass="right-[12%] top-[46%]"
    />
    <div class="container">
      <div class="relative z-1 mb-12 text-center lg:mx-auto lg:w-10/12">
        <h1 class="text-h1 text-headings mb-6">{title}</h1>
        {shortDescription && <p>{shortDescription}</p>}

        <div class="mt-7.5 mb-12 flex flex-col items-center">
          <ProductGallery id={`case-details-carousel-${product.id}`} images={gallery} />
        </div>

        {
          table && table.length > 0 && (
            <div class="bg-accent mt-12.5 mb-2.5 flex flex-col flex-wrap justify-center rounded-[20px] px-0 py-7.5 text-white sm:mt-17.5 sm:mb-12.5 sm:flex-row sm:px-5">
              {table
                .filter((item) => item != null)
                .map((item) => (
                  <div class="w-full py-0 not-last:mb-7.5 sm:w-1/2 sm:py-2.5 sm:not-last:mb-0 md:w-1/3">
                    <h5 class="text-h5 text-light">{item.title}</h5>
                    <p class="m-0">{item.description}</p>
                  </div>
                ))}
            </div>
          )
        }

        <div class="prose mx-auto max-w-none text-center">
          <Content />
        </div>
      </div>

      <div class="relative z-1 lg:mx-auto lg:w-10/12">
        <nav class="flex items-center justify-between gap-4 sm:gap-8">
          {
            prev ? (
              <a class="group flex items-center" href={`/product/${prev.id}/`}>
                <span class="text-dark mr-3 leading-none">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15.556"
                    height="28.285"
                    viewBox="0 0 15.556 28.285"
                    fill="currentColor"
                  >
                    <path d="M3.391 12.728l9.75 14.142-.982 1.414-9.742-14.142z" />
                    <path d="M13.137 1.41L3.39 15.558l-.975-1.415L12.166 0z" />
                  </svg>
                </span>
                <span class="text-left">
                  <span class="text-body block text-sm">Előző</span>
                  <span class="font-heading text-dark group-hover:text-sand-300 block text-xl">
                    {prev.data.title}
                  </span>
                </span>
              </a>
            ) : (
              <span />
            )
          }

          <ul class="hidden items-center sm:flex">
            {
              shareLinks.map((link) => (
                <li class="not-last:mr-6">
                  <a
                    class="text-body hover:text-sand-300 block transition-colors hover:scale-110"
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name={link.icon} class="text-lg" />
                  </a>
                </li>
              ))
            }
          </ul>

          {
            next ? (
              <a class="group flex items-center" href={`/product/${next.id}/`}>
                <span class="text-right">
                  <span class="text-body block text-sm">Következő</span>
                  <span class="font-heading text-dark group-hover:text-sand-300 block text-xl">
                    {next.data.title}
                  </span>
                </span>
                <span class="text-dark ml-3 leading-none">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15.556"
                    height="28.285"
                    viewBox="0 0 15.556 28.285"
                    fill="currentColor"
                  >
                    <path d="M12.162 12.725L2.416 26.87l.978 1.41 9.746-14.138z" />
                    <path d="M2.416 1.415l9.743 14.141.975-1.414L3.39 0z" />
                  </svg>
                </span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </div>
    </div>
  </section>
</Base>
