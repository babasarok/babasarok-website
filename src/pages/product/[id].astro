---
import { Icon } from "astro-icon/components";
import Base from "../../layouts/Base.astro";
import { localeFromPathname } from "../../lib/i18n";
import { createI18n } from "../../lib/i18next";

const i18n = createI18n(localeFromPathname(Astro.url.pathname));
const t = i18n.t.bind(i18n);
import ProductGallery from "../../components/ui/ProductGallery.astro";
import Markdown from "../../components/ui/Markdown.astro";
import ProductOrder from "../../components/blocks/order/ProductOrder.svelte";
import {
  getMaterials,
  getProduct,
  getProductGroups,
  getProducts,
  getThreadColors,
} from "@/lib/catalog";
import { toOrderGroups, toOrderProduct, toOrderThreadColors } from "@/lib/catalog/orderProduct";
import { ASSET_BASE, pageLanguageCode } from "@/lib/vendure/client";

export const prerender = false;

const languageCode = pageLanguageCode(Astro.url.pathname);
const product = await getProduct(Astro.params.id ?? "", undefined, languageCode);

if (product === null) {
  Astro.cache.set(false);

  return new Response(null, { status: 404 });
}

const [products, groups, materials, threadColors] = await Promise.all([
  getProducts(undefined, languageCode),
  getProductGroups(undefined, languageCode),
  getMaterials(undefined, languageCode),
  getThreadColors(undefined, languageCode),
]);

const { definition, name: title, shortDescription } = product;

const newestFirst = products.toSorted(
  (a, b) => new Date(b.date ?? 0).getTime() - new Date(a.date ?? 0).getTime()
);
const index = newestFirst.findIndex((candidate) => candidate.slug === product.slug);
const prev = newestFirst.slice(0, index).at(-1);
const next = newestFirst.at(index + 1);

const relatedIds = new Set(
  groups
    .filter((group) => group.productIds.includes(definition.id))
    .flatMap((group) => group.productIds)
);
const orderCatalog = Object.fromEntries(
  products
    .filter((candidate) => relatedIds.has(candidate.definition.id))
    .map((candidate) => [candidate.definition.id, toOrderProduct(candidate, materials, ASSET_BASE)])
);
const orderProduct = toOrderProduct(product, materials, ASSET_BASE);
const slugByProductId = Object.fromEntries(
  products.map((candidate) => [candidate.definition.id, candidate.slug])
);

const gallery = product.gallery.map((image) => ({
  src: image.url,
  alt: title,
  description: image.description ?? undefined,
}));

if (gallery.length === 0 && product.thumbnailUrl) {
  gallery.push({ src: product.thumbnailUrl, alt: title, description: undefined });
}

const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const shareLinks = [
  {
    icon: "fa-brands:facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`,
  },
  {
    icon: "fa-brands:linkedin",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`,
  },
  {
    icon: "fa-brands:twitter",
    href: `https://twitter.com/intent/tweet?&url=${shareUrl}`,
  },
];
---

<Base title={title} description={shortDescription ?? undefined} isArticle>
  <section class="relative overflow-hidden pt-30 pb-25 sm:pt-50">
    <div class="container">
      <div class="relative z-1 mb-12">
        <div class="grid grid-cols-1 items-start justify-start gap-8 lg:grid-cols-2 lg:gap-16">
          <div class="lg:sticky">
            <ProductGallery id={`case-details-carousel-${product.slug}`} images={gallery} />
          </div>
          <div class="flex flex-col text-left">
            <h1 class="text-h2 text-headings">{title}</h1>
            {shortDescription && <p class="mt-3">{shortDescription}</p>}
            <div class="mt-6">
              <ProductOrder
                locale={localeFromPathname(Astro.url.pathname)}
                slug={product.slug}
                product={orderProduct}
                definition={definition}
                products={orderCatalog}
                productGroups={toOrderGroups(groups)}
                slugByProductId={slugByProductId}
                threadColors={toOrderThreadColors(threadColors, ASSET_BASE)}
                client:load
              />
            </div>
          </div>
        </div>

        <div class="prose mt-12 max-w-none">
          {product.description && <Markdown source={product.description} />}
        </div>
      </div>

      <div class="relative z-1 lg:mx-auto lg:w-10/12">
        <nav class="flex items-center justify-between gap-4 sm:gap-8">
          {
            prev ? (
              <a class="group flex items-center" href={`/product/${prev.slug}/`}>
                <span class="text-dark mr-3 leading-none">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15.556"
                    height="28.285"
                    viewBox="0 0 15.556 28.285"
                    fill="currentColor"
                  >
                    <path d="M3.391 12.728l9.75 14.142-.982 1.414-9.742-14.142z" />
                    <path d="M13.137 1.41L3.39 15.558l-.975-1.415L12.166 0z" />
                  </svg>
                </span>
                <span class="text-left">
                  <span class="text-body block text-sm">{t("common.previous")}</span>
                  <span class="font-heading text-dark group-hover:text-sand-300 block text-xl">
                    {prev.name}
                  </span>
                </span>
              </a>
            ) : (
              <span />
            )
          }

          <ul class="hidden items-center sm:flex">
            {
              shareLinks.map((link) => (
                <li class="not-last:mr-6">
                  <a
                    class="text-body hover:text-sand-300 block transition-colors hover:scale-110"
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name={link.icon} class="text-lg" />
                  </a>
                </li>
              ))
            }
          </ul>

          {
            next ? (
              <a class="group flex items-center" href={`/product/${next.slug}/`}>
                <span class="text-right">
                  <span class="text-body block text-sm">{t("common.next")}</span>
                  <span class="font-heading text-dark group-hover:text-sand-300 block text-xl">
                    {next.name}
                  </span>
                </span>
                <span class="text-dark ml-3 leading-none">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15.556"
                    height="28.285"
                    viewBox="0 0 15.556 28.285"
                    fill="currentColor"
                  >
                    <path d="M12.162 12.725L2.416 26.87l.978 1.41 9.746-14.138z" />
                    <path d="M2.416 1.415l9.743 14.141.975-1.414L3.39 0z" />
                  </svg>
                </span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </div>
    </div>
  </section>
</Base>
