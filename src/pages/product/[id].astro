---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Base from "../../layouts/Base.astro";
import FloatingShapes from "../../components/ui/FloatingShapes.astro";
import ProductGallery from "../../components/ui/ProductGallery.astro";
import { resolveImage } from "../../lib/assets";

type GalleryImage = {
  src: ImageMetadata;
  alt: string;
  description?: string | undefined;
};

export const getStaticPaths = (async () => {
  const products = (await getCollection("product")).sort(
    (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
  );

  return products.map((product, i) => ({
    params: { id: product.id },
    props: {
      product,
      prev: products[i - 1] ?? null,
      next: products[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { product, prev, next } = Astro.props;
const { Content } = await render(product);

const { title, shortDescription, table = [] } = product.data;

const gallery: GalleryImage[] = [];
const thumb = resolveImage(product.data.thumbnail);
if (thumb) gallery.push({ src: thumb, alt: title });
for (const entry of product.data.images ?? []) {
  const img = resolveImage(entry.image);
  if (img) gallery.push({ src: img, alt: title, description: entry.description });
}

const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const shareLinks = [
  {
    icon: "fa-brands:facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`,
  },
  {
    icon: "fa-brands:linkedin",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`,
  },
  {
    icon: "fa-brands:twitter",
    href: `https://twitter.com/intent/tweet?&url=${shareUrl}`,
  },
];
---

<Base title={title} description={shortDescription} isArticle>
  <section class="relative overflow-hidden pt-50 pb-25 max-sm:pt-30">
    <FloatingShapes
      figureClass="top-[30%] left-[-7%]"
      blobClass="right-[4%] top-[29%]"
      patternClass="right-[12%] top-[46%]"
    />

    <div class="container">
      <div class="relative z-1 mb-12 text-center lg:mx-auto lg:w-10/12">
        <h1>{title}</h1>
        {shortDescription && <p>{shortDescription}</p>}

        <div class="mt-7.5 mb-12 flex flex-col items-center">
          <ProductGallery
            id={`case-details-carousel-${product.id}`}
            images={gallery}
          />
        </div>

        {
          table.length > 0 && (
            <div class="mt-17.5 mb-12.5 flex flex-wrap justify-center rounded-[20px] bg-accent px-5 py-7.5 text-white max-sm:my-12.5 max-sm:mb-2.5 max-sm:flex-col max-sm:px-0 max-sm:py-7.5">
              {table.map((item) => (
                <div class="w-1/3 py-2.5 max-md:w-1/2 max-sm:w-full max-sm:py-0 max-sm:not-last:mb-7.5">
                  <h5 class="mb-0 text-light">{item.title}</h5>
                  <p class="m-0">{item.description}</p>
                </div>
              ))}
            </div>
          )
        }

        <div class="prose mx-auto max-w-none text-center">
          <Content />
        </div>
      </div>

      <div class="relative z-1 lg:mx-auto lg:w-10/12">
        <nav class="flex items-center justify-between gap-8 max-sm:gap-4">
          {
            prev ? (
              <a
                class="group flex items-center"
                href={`/product/${prev.id}/`}
              >
                <span class="mr-3 leading-none text-dark">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15.556"
                    height="28.285"
                    viewBox="0 0 15.556 28.285"
                    fill="currentColor"
                  >
                    <path d="M3.391 12.728l9.75 14.142-.982 1.414-9.742-14.142z" />
                    <path d="M13.137 1.41L3.39 15.558l-.975-1.415L12.166 0z" />
                  </svg>
                </span>
                <span class="text-left">
                  <span class="block text-sm text-body">Előző</span>
                  <span class="block font-heading text-xl text-dark group-hover:text-primary">
                    {prev.data.title}
                  </span>
                </span>
              </a>
            ) : (
              <span />
            )
          }

          <ul class="flex items-center max-sm:hidden">
            {shareLinks.map((link) => (
              <li class="not-last:mr-6">
                <a
                  class="block text-body transition-colors hover:text-primary hover:scale-110"
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name={link.icon} class="text-lg" />
                </a>
              </li>
            ))}
          </ul>

          {
            next ? (
              <a
                class="group flex items-center"
                href={`/product/${next.id}/`}
              >
                <span class="text-right">
                  <span class="block text-sm text-body">Következő</span>
                  <span class="block font-heading text-xl text-dark group-hover:text-primary">
                    {next.data.title}
                  </span>
                </span>
                <span class="ml-3 leading-none text-dark">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15.556"
                    height="28.285"
                    viewBox="0 0 15.556 28.285"
                    fill="currentColor"
                  >
                    <path d="M12.162 12.725L2.416 26.87l.978 1.41 9.746-14.138z" />
                    <path d="M2.416 1.415l9.743 14.141.975-1.414L3.39 0z" />
                  </svg>
                </span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </div>
    </div>
  </section>
</Base>
