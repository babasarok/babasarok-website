---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import ProductList from "../../components/blocks/product/ProductList.svelte";
import {
  optimizeIslandImage,
  PRODUCT_CARD_IMAGE_WIDTH,
  PRODUCT_CARD_IMAGE_SIZES,
} from "../../lib/data";

const products = (await getCollection("product"))
  .filter((p) => p.data.hidden_in_product_list !== true)
  .toSorted((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

const groups = await getCollection("productGroup");

/** Set membership, keyed by product entry id (the content file name). */
const setMembership: Record<string, string[]> = {};
const sets = groups.map((group) => {
  for (const member of group.data.products ?? []) {
    const path = member?.product;
    if (!path) {
      continue;
    }
    const entryId = path.slice(path.lastIndexOf("/") + 1).replace(/\.md$/, "");
    (setMembership[entryId] ??= []).push(group.id);
  }
  return { id: group.id, title: group.data.title };
});

const items = await Promise.all(
  products.map(async (product) => ({
    id: product.id,
    title: product.data.title,
    shortDescription: product.data.shortDescription ?? undefined,
    type: product.data.type,
    date: product.data.date?.toISOString(),
    sets: setMembership[product.id] ?? [],
    href: `/product/${product.id}/`,
    category: product.data.categories ?? undefined,
    image: product.data.thumbnail
      ? await optimizeIslandImage(
          product.data.thumbnail,
          PRODUCT_CARD_IMAGE_WIDTH,
          PRODUCT_CARD_IMAGE_SIZES
        )
      : undefined,
  }))
);
---

<Base title="Termékek">
  <PageHeader title="Termékek" no-shapes compact />
  <section class="py-12">
    <div class="container xl:max-w-375 xl:px-3.5">
      <ProductList client:load items={items} sets={sets} />
    </div>
  </section>
</Base>
