---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import ProductList from "../../components/blocks/product/ProductList.svelte";
import { getProductGroups, getProducts } from "@/lib/catalog";
import { toProductListData } from "@/lib/catalog/listItems";
import { ASSET_BASE } from "@/lib/vendure/client";

export const prerender = false;

const [products, groups] = await Promise.all([getProducts(), getProductGroups()]);
const { items, sets, popularOrder } = toProductListData(products, groups, ASSET_BASE);
---

<Base title="Termékek">
  <PageHeader title="Termékek" no-shapes compact />
  <section class="py-12">
    <div class="container xl:max-w-375 xl:px-3.5">
      <ProductList client:load items={items} sets={sets} popularOrder={popularOrder} />
    </div>
  </section>
</Base>
