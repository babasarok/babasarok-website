---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import ProductCard from "../../components/ui/ProductCard.astro";
import Pagination from "../../components/ui/Pagination.astro";

export const getStaticPaths = (async () => {
  const PAGE_SIZE = 6;
  const products = (await getCollection("product"))
    .filter((p) => p.data.hidden_in_product_list !== true)
    .toSorted((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

  const lastPage = Math.max(1, Math.ceil(products.length / PAGE_SIZE));

  return Array.from({ length: lastPage }, (_, i) => {
    const currentPage = i + 1;
    return {
      params: { page: currentPage === 1 ? undefined : `page/${currentPage}` },
      props: {
        items: products.slice(i * PAGE_SIZE, (i + 1) * PAGE_SIZE),
        currentPage,
        lastPage,
      },
    };
  });
}) satisfies GetStaticPaths;

const { items, currentPage, lastPage } = Astro.props;
---

<Base title="Termékek">
  <PageHeader title="Termékek" />
  <section class="py-25">
    <div class="container">
      <div class="flex flex-wrap justify-center gap-8 gap-y-12 sm:gap-y-8">
        {
          items.map((product) => (
            <ProductCard
              href={`/product/${product.id}/`}
              title={product.data.title}
              image={product.data.thumbnail}
              category={product.data.categories}
              square
            />
          ))
        }
      </div>
      <Pagination currentPage={currentPage} lastPage={lastPage} basePath="/product" />
    </div>
  </section>
</Base>
