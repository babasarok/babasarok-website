---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import MaterialList from "../../components/blocks/catalog/MaterialList.svelte";
import { localeFromPathname } from "../../lib/i18n";
import { createI18n } from "../../lib/i18next";

const locale = localeFromPathname(Astro.url.pathname);
const i18n = createI18n(locale);
const t = i18n.t.bind(i18n);
---

<Base title={t("pages.materials")}>
  <PageHeader title={t("pages.materials")} />
  <section class="py-25">
    <div class="container">
      <MaterialList client:load {locale} />
    </div>
  </section>
</Base>
