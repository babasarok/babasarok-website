---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import ProductCard from "../../components/ui/ProductCard.astro";
import { getMaterials } from "@/lib/catalog";
import { pageLanguageCode } from "@/lib/vendure/client";
import { localeFromPathname, localizedPath } from "../../lib/i18n";
import { createI18n } from "../../lib/i18next";

const i18n = createI18n(localeFromPathname(Astro.url.pathname));
const t = i18n.t.bind(i18n);

export const prerender = false;

const languageCode = pageLanguageCode(Astro.url.pathname);
const locale = localeFromPathname(Astro.url.pathname);
const materials = (await getMaterials(undefined, languageCode)).toSorted((a, b) =>
  a.label.localeCompare(b.label, locale)
);
---

<Base title={t("pages.materials")}>
  <PageHeader title={t("pages.materials")} />
  <section class="py-25">
    <div class="container">
      <div class="flex flex-wrap justify-center gap-8 gap-y-12 sm:gap-y-8">
        {
          materials.map((material) => (
            <ProductCard
              href={localizedPath(`/material/${material.slug}/`, locale)}
              title={material.label}
              image={material.thumbnailUrl ?? undefined}
              category={material.subtitle || undefined}
            />
          ))
        }
      </div>
    </div>
  </section>
</Base>
