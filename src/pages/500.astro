---
import Base from "../layouts/Base.astro";
import { localeFromPathname } from "../lib/i18n";
import { createI18n } from "../lib/i18next";

const i18n = createI18n(localeFromPathname(Astro.url.pathname));
const t = i18n.t.bind(i18n);
---

<Base title={t("pages.unavailable")}>
  <section
    class="relative flex min-h-[70vh] items-center justify-center overflow-hidden px-6 text-center"
  >
    <h1 class="text-h1 text-headings mb-6">{t("pages.unavailable")}</h1>
  </section>
</Base>
