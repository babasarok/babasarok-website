---
import Header from '../components/blocks/Header.astro';
import Footer from '../components/blocks/Footer.astro';
import { Font } from "astro:assets";
import { getConfig } from '../lib/data';
import "../styles/global.css";

// ── Favicon imports (processed by Vite asset pipeline) ───────────────────────
import faviconIco from '../assets/favicons/favicon.ico?url';
import favicon16 from '../assets/favicons/favicon-16x16.png?url';
import favicon32 from '../assets/favicons/favicon-32x32.png?url';
import appleTouchIcon from '../assets/favicons/apple-touch-icon.png?url';
import safariPinnedTab from '../assets/favicons/safari-pinned-tab.svg?url';

interface Props {
	title: string;
	description?: string | null | undefined;
	/** Absolute URL for og:image */
	image?: string;
	/** Set to true on blog/product detail pages */
	isArticle?: boolean;
	/** Override robots directive, default: "index, follow" */
	robots?: string;
}

const {
	title,
	description,
	image,
	isArticle = false,
	robots = "index, follow",
} = Astro.props;

const config = (await getConfig()).data?.config ?? null;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogLocale = config?.ogLocale ?? "hu_HU";
const themeColor = config?.themeColor ?? "#F1D3B2";
const ga = config?.googleAnalytics ?? "";
---

<!doctype html>
<html lang="hu">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="x-ua-compatible" content="ie=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- SEO -->
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta name="robots" content={robots} />
		<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
		<link rel="canonical" href={canonicalURL.href} />

		<!-- Open Graph -->
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:type" content={isArticle ? "article" : "website"} />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:site_name" content={config?.title ?? "Babasarok"} />
		{image && <meta property="og:image" content={image} />}

		<!-- Sitemap -->
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Favicons -->
		<meta name="theme-color" content={themeColor} />
		<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon} />
		<link rel="icon" type="image/png" sizes="32x32" href={favicon32} />
		<link rel="icon" type="image/png" sizes="16x16" href={favicon16} />
		<link rel="icon" type="image/x-icon" href={faviconIco} />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="mask-icon" href={safariPinnedTab} color="#5bbad5" />

		<!-- Fonts -->
		<Font cssVariable="--font-base" preload />
		<Font cssVariable="--font-heading" preload />

		<!-- Google Analytics -->
		{ga && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
				<script define:vars={{ ga }}>
					window.dataLayer = window.dataLayer || [];
					function gtag() { dataLayer.push(arguments); }
					gtag('js', new Date());
					gtag('config', ga);
				</script>
			</>
		)}
	</head>
	<body>
		<Header />
		<div id="content" role="document">
			<slot />
		</div>
		<Footer />
	</body>
</html>
