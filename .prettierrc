{
    "plugins": [
        "prettier-plugin-go-template",
        "prettier-plugin-svelte"
    ],
    "bracketSameLine": true,
    "trailingComma": "es5",
    "jsxSingleQuote": true,
    "printWidth": 120,
    "semi": true,
    "overrides": [
        {
            "files": [
                "*.html"
            ],
            "options": {
                "parser": "go-template"
            }
        },
        {
            "files": "*.svelte",
            "options": {
                "parser": "svelte"
            }
        }
    ]
}