{
  "name": "babasarok-vendure-backend",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsc -b && node --env-file-if-exists=.env dist/migrate.js && (tsc -b --watch --preserveWatchOutput & node --watch --env-file-if-exists=.env dist/index.js & node --watch --env-file-if-exists=.env dist/index-worker.js)",
    "dashboard": "node --env-file-if-exists=build.env --env-file-if-exists=.env ./node_modules/vite/bin/vite.js",
    "dashboard:build": "node --env-file-if-exists=build.env --env-file-if-exists=.env ./node_modules/vite/bin/vite.js build && npx prettier --write src/gql >/dev/null",
    "gql:fresh": "pnpm run dashboard:build >/dev/null && npx prettier --write src/gql >/dev/null && git diff --exit-code -- src/gql",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "worker": "node --env-file-if-exists=.env dist/index-worker.js",
    "migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "generate-migration": "node --env-file-if-exists=.env dist/generate-migration.js",
    "import-materials": "tsx --env-file-if-exists=.env scripts/import-materials.ts",
    "import-facets": "tsx --env-file-if-exists=.env scripts/import-facets.ts",
    "import-products": "tsx --env-file-if-exists=.env scripts/import-products.ts",
    "converge-facets": "tsx --env-file-if-exists=.env scripts/converge-facets.ts",
    "test:quote-roundtrip": "tsx --env-file-if-exists=.env scripts/quote-order-roundtrip.ts",
    "e2e:server": "tsx --env-file=e2e.env scripts/e2e-server.ts",
    "check": "tsc -b && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.integration.json",
    "check:dashboard": "tsx scripts/check-dashboard-types.ts",
    "test": "vitest run",
    "test:integration": "tsc -b && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "~14.0.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@vendure/asset-server-plugin": "^3.8.1",
    "@vendure/common": "^3.8.1",
    "@vendure/core": "^3.8.1",
    "@vendure/dashboard": "^3.8.1",
    "@vendure/email-plugin": "^3.8.1",
    "cloudflare": "^7.3.0",
    "graphql-tag": "^2.12.6",
    "handlebars": "^4.7.10",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@graphql-typed-document-node/core": "3.2.0",
    "@tanstack/react-query": "^5.91.0",
    "@tanstack/react-router": "1.170.46",
    "@types/pg": "^8.23.1",
    "@vendure/testing": "3.8.1",
    "gql.tada": "^1.11.4",
    "tsx": "^4.23.15",
    "typeorm": "^0.3.31",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
