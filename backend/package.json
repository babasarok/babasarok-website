{
  "name": "babasarok-vendure-backend",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsc && node --env-file-if-exists=.env dist/migrate.js && (tsc --watch --preserveWatchOutput & node --watch --env-file-if-exists=.env dist/index.js & node --watch --env-file-if-exists=.env dist/index-worker.js)",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "worker": "node --env-file-if-exists=.env dist/index-worker.js",
    "build-admin-ui": "node dist/build-admin-ui.js",
    "migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "generate-migration": "node --env-file-if-exists=.env dist/generate-migration.js",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/graphql": "~14.0.0",
    "@vendure/admin-ui-plugin": "^3.8.1",
    "@vendure/common": "^3.8.1",
    "@vendure/core": "^3.8.1",
    "@vendure/email-plugin": "^3.8.1",
    "cloudflare": "^7.3.0",
    "graphql-tag": "^2.12.6",
    "handlebars": "^4.7.10",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vendure/admin-ui": "3.8.1",
    "@vendure/ui-devkit": "^3.8.1",
    "typeorm": "^0.3.31",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
