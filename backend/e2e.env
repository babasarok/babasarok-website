# Runtime env for the dashboard e2e suite (backend/scripts/e2e-server.ts,
# booted by playwright.dashboard.config.ts). Complete on purpose — the e2e
# processes read only this file, never backend/.env, so every run uses the
# same fixed credentials and database. The database is dropped and re-created
# per run: locally on the compose postgres, in CI on the workflow's postgres
# service (same credentials both places). Mirrors build.env's role for the
# dashboard build (vendure-config validates env at import time).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://babasarok:babasarok@localhost:5432/babasarok_e2e
TOKEN_SECRET=e2e-only-token-secret-0123456789
SHOP_OWNER_EMAIL=rendeles@babasarok.test
ORDER_EMAIL_FROM="Babasarok E2E <rendeles@babasarok.test>"
SUPERADMIN_EMAIL=admin@babasarok.local
SUPERADMIN_PASSWORD=superadmin
