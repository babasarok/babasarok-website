# Local development environment for the Vendure backend (docker compose up postgres first).
# Copy to backend/.env — it is read via node --env-file-if-exists.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://babasarok:babasarok@localhost:5432/babasarok

# Any 16+ char string; only signs API tokens in dev.
TOKEN_SECRET=local-dev-token-secret-change-me

# Where order notification emails go, and the From: header of all order emails.
SHOP_OWNER_EMAIL=rendeles@babasarok.test
ORDER_EMAIL_FROM="Babasarok <rendeles@babasarok.test>"

# First superadmin created on an empty database (Admin UI: /admin-api → admin-ui).
SUPERADMIN_EMAIL=admin@babasarok.test
SUPERADMIN_PASSWORD=supersecret1

# Leave SMTP_HOST unset in dev: emails render into backend/email-out and are
# browsable at http://localhost:4000/mailbox.
# SMTP_HOST=postfix
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Comma-separated CORS origins; unset = allow all (dev only).
# API_ALLOWED_ORIGINS=https://babasarok.net,https://www.babasarok.net
