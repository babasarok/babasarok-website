# Placeholder env for the dashboard vite build (run by
# integrations/vendure-dashboard.ts). It imports
# vendure-config.ts, which validates env at import time and exits when
# required vars are missing; vite sets NODE_ENV=production for that import,
# so these must satisfy the production gates. They are never used at runtime —
# server/worker processes read the real env from --env-file=.env, and env vars
# provided by the build environment (e.g. PUBLIC_VENDURE_API_URL on Cloudflare)
# take precedence over these placeholders.
DATABASE_URL=postgres://build:build@localhost/build
TOKEN_SECRET=build-only-placeholder-secret
SHOP_OWNER_EMAIL=build@example.com
ORDER_EMAIL_FROM=build@example.com
EMAIL_TRANSPORT=smtp
SMTP_HOST=build.invalid
SUPERADMIN_EMAIL=build@example.com
SUPERADMIN_PASSWORD=build-only-placeholder
