# Runtime env for the backend integration suite (integration/harness.ts).
# Complete on purpose, like e2e.env: the suite reads only this file, never
# backend/.env, and file email transport is guaranteed (no EMAIL_TRANSPORT /
# SMTP_HOST), so a run can never send real mail. The database is dropped and
# re-created per test file (locally on the compose postgres, in CI on the
# workflow's postgres service).
NODE_ENV=development
PORT=4010
DATABASE_URL=postgres://babasarok:babasarok@localhost:5432/babasarok_int
TOKEN_SECRET=integration-only-token-secret-0123456789
SHOP_OWNER_EMAIL=rendeles@babasarok.test
ORDER_EMAIL_FROM="Babasarok Integration <rendeles@babasarok.test>"
SUPERADMIN_EMAIL=admin@babasarok.local
SUPERADMIN_PASSWORD=superadmin
