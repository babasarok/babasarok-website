{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["src/**/dashboard/*", "src/gql/*", "vite.*.*ts"],
  // tsconfig.dashboard.json stays editor-only: its @/vdb paths map in the
  // whole dashboard source graph, which does not type-check under plain tsc.
  "references": [
    { "path": "../packages/product-definition" },
    { "path": "./tsconfig.scripts.json" }
  ]
}
